parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        # Form types reference Symfony Form/Validator; analyse when bundle is used in an app
        - src/Form/*
    bootstrapFiles:
        - vendor/autoload.php
    reportUnmatchedIgnoredErrors: false

includes:
    - phpstan-baseline.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
