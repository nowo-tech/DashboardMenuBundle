{
  "name": "nowo-tech/dashboard-menu-bundle",
  "description": "Assets build for Dashboard Menu Bundle (TypeScript)",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "VITE_ENTRY=dashboard vite build && VITE_ENTRY=stimulus-live vite build && VITE_ENTRY=menu-collapse vite build",
    "dev": "VITE_ENTRY=dashboard vite build --watch",
    "watch": "VITE_ENTRY=dashboard vite build --watch",
    "build:dashboard": "VITE_ENTRY=dashboard vite build",
    "build:stimulus-live": "VITE_ENTRY=stimulus-live vite build",
    "build:menu-collapse": "VITE_ENTRY=menu-collapse vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "sortablejs": "^1.15.6"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.8",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.14.6",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
