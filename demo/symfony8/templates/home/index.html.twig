{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.home_title'|trans({}, _demo_domain) }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.bundle_demo'|trans({}, _demo_domain),
        intro: 'demo.lead_paragraph'|trans({}, _demo_domain),
    }) }}
{% endblock %}

{% macro context_menu(tree, code, config) %}
    {% set _classes = {menu: 'nowo-ui-aside__nav', item: '', link: 'nowo-ui-aside__link', children: 'nowo-ui-aside__nav'} %}
    {% set _cfg = (config|default({}))|merge({ classes: ((config|default({})).classes|default({}))|merge(_classes) }) %}
    {% include '@NowoDashboardMenuBundle/menu.html.twig' with { menuTree: tree, menuCode: code, menuConfig: _cfg } %}
{% endmacro %}

{% block body %}
<p>{{ 'demo.sidebar_rendered'|trans({}, _demo_domain)|raw }}</p>

<section class="nowo-ui-card">
    <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">{{ 'demo.crud_title'|trans({}, _demo_domain) }}</h2></div>
    <div class="nowo-ui-card__body">
        <p>{{ 'demo.crud_intro'|trans({}, _demo_domain)|raw }}</p>
        <ul class="nowo-ui-list">
            <li class="nowo-ui-list-item"><a class="nowo-ui-link" href="{{ path('nowo_dashboard_menu_dashboard_index') }}">{{ 'demo.list_menus'|trans({}, _demo_domain) }}</a> <code class="nowo-ui-code">/admin/menus</code></li>
            <li class="nowo-ui-list-item"><a class="nowo-ui-link" href="{{ path('nowo_dashboard_menu_dashboard_menu_new') }}">{{ 'demo.new_menu'|trans({}, _demo_domain) }}</a> <code class="nowo-ui-code">/admin/menus/menu/new</code></li>
        </ul>
        <p class="nowo-ui-muted">{{ 'demo.crud_footer'|trans({}, _demo_domain) }}</p>
    </div>
</section>

<p><strong>{{ 'demo.api_json'|trans({}, _demo_domain) }}</strong> <a class="nowo-ui-link" href="{{ path('nowo_dashboard_menu_api', { code: 'sidebar' }) }}">GET /api/menu/sidebar</a></p>

<section class="nowo-ui-card">
    <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">{{ 'demo.context_resolution_title'|trans({}, _demo_domain) }}</h2></div>
    <div class="nowo-ui-card__body">
        <p class="nowo-ui-muted">{{ 'demo.context_resolution_intro'|trans({}, _demo_domain)|raw }}</p>
        <div class="nowo-ui-cards">
            <div class="nowo-ui-card">
                <div class="nowo-ui-card__header"><h3 class="nowo-ui-card__title">{{ 'demo.context_example_second_result'|trans({}, _demo_domain) }}</h3></div>
                <div class="nowo-ui-card__body">
                    <p><code class="nowo-ui-code">dashboard_menu_tree('sidebar', null, [{'partnerId': 99}, {}])</code></p>
                    {% set contextSetsSecond = [{ 'partnerId': 99 }, {}] %}
                    {% set treeSecond = dashboard_menu_tree('sidebar', null, contextSetsSecond) %}
                    <nav class="nowo-ui-aside__nav">
                        {% if treeSecond is not empty %}
                            {{ _self.context_menu(treeSecond, 'sidebar', dashboard_menu_config('sidebar', contextSetsSecond)) }}
                        {% else %}
                            <span class="nowo-ui-muted">{{ 'demo.context_no_menu'|trans({}, _demo_domain) }}</span>
                        {% endif %}
                    </nav>
                </div>
            </div>
            <div class="nowo-ui-card">
                <div class="nowo-ui-card__header"><h3 class="nowo-ui-card__title">{{ 'demo.context_example_random'|trans({}, _demo_domain) }}</h3></div>
                <div class="nowo-ui-card__body">
                    <p><code class="nowo-ui-code">dashboard_menu_tree('sidebar', null, contextSets)</code></p>
                    {% set _first = random(2) == 0 ? [{ 'partnerId': 1, 'operatorId': 1 }, { 'partnerId': 1 }, null] : [{ 'partnerId': 1 }, { 'partnerId': 1, 'operatorId': 1 }, null] %}
                    {% set treeRandom = dashboard_menu_tree('sidebar', null, _first) %}
                    <nav class="nowo-ui-aside__nav">
                        {% if treeRandom is not empty %}
                            {{ _self.context_menu(treeRandom, 'sidebar', dashboard_menu_config('sidebar', _first)) }}
                        {% else %}
                            <span class="nowo-ui-muted">{{ 'demo.context_no_menu'|trans({}, _demo_domain) }}</span>
                        {% endif %}
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="nowo-ui-card">
    <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">{{ 'demo.render_options_title'|trans({}, _demo_domain) }}</h2></div>
    <div class="nowo-ui-card__body">
        <p class="nowo-ui-muted">{{ 'demo.render_options_intro'|trans({}, _demo_domain)|raw }}</p>
        {% set treeOptions = dashboard_menu_tree('sidebar') %}
        {% set _cfg3 = dashboard_menu_config('sidebar')|default({}) %}
        {% set configOptions = _cfg3|merge({ nested_group_display: 'link_row', group_children_marker: 'dot', toggle_icon: 'bi:chevron-down', nested_default: 'current' }) %}
        <nav class="nowo-ui-aside__nav demo-render-options">
            {% include '@NowoDashboardMenuBundle/menu.html.twig' with { menuTree: treeOptions, menuCode: 'sidebar-options', menuConfig: configOptions } %}
        </nav>
    </div>
</section>
{% endblock %}
