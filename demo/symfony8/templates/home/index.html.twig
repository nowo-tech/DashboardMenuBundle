{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.home_title'|trans({}, _demo_domain) }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_dashboard_menu_dashboard_index') }}">{{ 'demo.manage_menus'|trans({}, _demo_domain) }}</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.bundle_demo'|trans({}, _demo_domain),
        intro: 'demo.lead_paragraph'|trans({}, _demo_domain),
        toolbar: _toolbar,
    }) }}
{% endblock %}

{% block body %}
{#- One menu example at a time: server-side UiKit tabs (?example=…), so the page stays short and needs no script. -#}
{% set _examples = ['sidebar', 'aside', 'footer', 'context', 'options'] %}
{% set _example = app.request.query.get('example') in _examples ? app.request.query.get('example') : 'sidebar' %}
{% set _tabs = [] %}
{% for _e in _examples %}
    {% set _tabs = _tabs|merge([{label: ('demo.tab_' ~ _e)|trans({}, _demo_domain), href: path('app_home', {example: _e}) ~ '#demo-examples', current: _e == _example, attr: {'data-testid': 'demo-example-tab-' ~ _e}}]) %}
{% endfor %}

{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.examples_title'|trans({}, _demo_domain), intro: 'demo.sidebar_rendered'|trans({}, _demo_domain)|striptags, id: 'demo-examples', testid: 'demo-rendered-menus'} %}
    {% block section_body %}
        {{ include(nowo_ui_partial('tabs'), {items: _tabs, aria_label: 'demo.examples_label'|trans({}, _demo_domain)}) }}
        <div data-testid="demo-example-{{ _example }}">
        {% if _example in ['sidebar', 'aside'] %}
            <nav class="nowo-ui-aside__nav" aria-label="{{ ('demo.tab_' ~ _example)|trans({}, _demo_domain) }}" data-testid="demo-menu-{{ _example }}">
                {% include '_menu.html.twig' with {tree: dashboard_menu_tree(_example), code: _example, config: dashboard_menu_config(_example), variant: 'aside'} %}
            </nav>
            {#- 2.26 footer slot: its own <nav> landmark below the menu (nothing unless menu_layout.<code>.footer is configured). -#}
            {% include '@NowoDashboardMenuBundle/menu_footer.html.twig' with {menuTree: dashboard_menu_tree(_example), menuCode: _example} %}
        {% elseif _example == 'footer' %}
            <h3 id="demo-menu-footer">{{ 'demo.footer_menu'|trans({}, _demo_domain) }}</h3>
            <nav aria-labelledby="demo-menu-footer" data-testid="demo-menu-footer">
                {% include '_menu.html.twig' with {tree: dashboard_menu_tree('footer'), code: 'footer', config: dashboard_menu_config('footer'), variant: 'bar'} %}
            </nav>
            <h3 id="demo-menu-locale">{{ 'demo.locale_menu'|trans({}, _demo_domain) }}</h3>
            <nav aria-labelledby="demo-menu-locale" data-testid="demo-menu-locale">
                {% include '_menu.html.twig' with {tree: dashboard_menu_tree('locale_switcher'), code: 'locale_switcher', config: dashboard_menu_config('locale_switcher'), variant: 'bar'} %}
            </nav>
        {% elseif _example == 'context' %}
            <p class="nowo-ui-muted">{{ 'demo.context_resolution_intro'|trans({}, _demo_domain)|raw }}</p>
            <div class="nowo-ui-cards">
                <div class="nowo-ui-card">
                    <div class="nowo-ui-card__header"><h3 class="nowo-ui-card__title">{{ 'demo.context_example_second_result'|trans({}, _demo_domain) }}</h3></div>
                    <div class="nowo-ui-card__body">
                        <p><code class="nowo-ui-code">dashboard_menu_tree('sidebar', null, [{'partnerId': 99}, {}])</code></p>
                        {% set contextSetsSecond = [{'partnerId': 99}, {}] %}
                        {% set treeSecond = dashboard_menu_tree('sidebar', null, contextSetsSecond) %}
                        <nav class="nowo-ui-aside__nav" aria-label="{{ 'demo.context_example_second_result'|trans({}, _demo_domain) }}">
                            {% if treeSecond is not empty %}
                                {{ include('_menu.html.twig', {tree: treeSecond, code: 'sidebar', config: dashboard_menu_config('sidebar', contextSetsSecond), variant: 'aside'}) }}
                            {% else %}
                                <span class="nowo-ui-muted">{{ 'demo.context_no_menu'|trans({}, _demo_domain) }}</span>
                            {% endif %}
                        </nav>
                    </div>
                </div>
                <div class="nowo-ui-card">
                    <div class="nowo-ui-card__header"><h3 class="nowo-ui-card__title">{{ 'demo.context_example_random'|trans({}, _demo_domain) }}</h3></div>
                    <div class="nowo-ui-card__body">
                        <p><code class="nowo-ui-code">dashboard_menu_tree('sidebar', null, contextSets)</code></p>
                        {% set _first = random(2) == 0 ? [{'partnerId': 1, 'operatorId': 1}, {'partnerId': 1}, null] : [{'partnerId': 1}, {'partnerId': 1, 'operatorId': 1}, null] %}
                        {% set treeRandom = dashboard_menu_tree('sidebar', null, _first) %}
                        <nav class="nowo-ui-aside__nav" aria-label="{{ 'demo.context_example_random'|trans({}, _demo_domain) }}">
                            {% if treeRandom is not empty %}
                                {{ include('_menu.html.twig', {tree: treeRandom, code: 'sidebar', config: dashboard_menu_config('sidebar', _first), variant: 'aside'}) }}
                            {% else %}
                                <span class="nowo-ui-muted">{{ 'demo.context_no_menu'|trans({}, _demo_domain) }}</span>
                            {% endif %}
                        </nav>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="nowo-ui-muted">{{ 'demo.render_options_intro'|trans({}, _demo_domain)|raw }}</p>
            {% set _cfg3 = dashboard_menu_config('sidebar')|default({}) %}
            {% set configOptions = _cfg3|merge({classes: (_cfg3.classes|default({}))|merge({menu: 'nowo-ui-tree', link: 'nowo-ui-aside__link', children: 'nowo-ui-tree__group', section_children: 'nowo-ui-tree__group'}), nested_group_display: 'link_row', group_children_marker: 'dot', toggle_style: 'kit', nested_default: 'current'}) %}
            <nav class="nowo-ui-aside__nav" aria-label="{{ 'demo.tab_options'|trans({}, _demo_domain) }}">
                {% include '@NowoDashboardMenuBundle/menu.html.twig' with {menuTree: dashboard_menu_tree('sidebar'), menuCode: 'sidebar-options', menuConfig: configOptions} %}
            </nav>
        {% endif %}
        </div>
    {% endblock %}
{% endembed %}

{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.crud_title'|trans({}, _demo_domain), kind: 'list'} %}
    {% block section_body %}
        <p>{{ 'demo.crud_intro'|trans({}, _demo_domain)|raw }}</p>
        <ul class="nowo-ui-list">
            <li class="nowo-ui-list-item"><a class="nowo-ui-link" href="{{ path('nowo_dashboard_menu_dashboard_index') }}">{{ 'demo.list_menus'|trans({}, _demo_domain) }}</a> <code class="nowo-ui-code">/admin/menus</code></li>
            <li class="nowo-ui-list-item"><a class="nowo-ui-link" href="{{ path('nowo_dashboard_menu_dashboard_menu_new') }}">{{ 'demo.new_menu'|trans({}, _demo_domain) }}</a> <code class="nowo-ui-code">/admin/menus/menu/new</code></li>
            <li class="nowo-ui-list-item"><strong>{{ 'demo.api_json'|trans({}, _demo_domain) }}</strong> <a class="nowo-ui-link" href="{{ path('nowo_dashboard_menu_api', {code: 'sidebar'}) }}">GET /api/menu/sidebar</a></li>
        </ul>
        <p class="nowo-ui-muted">{{ 'demo.crud_footer'|trans({}, _demo_domain) }}</p>
    {% endblock %}
{% endembed %}
{% endblock %}
