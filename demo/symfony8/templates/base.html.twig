{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform) and drops the menus this bundle renders into the shell's extension
    block: the `dropdown` (user) menu in the top bar. The other menus render on the home page. The same layout
    hosts the bundle's admin pages (nowo_ui_kit.layouts.admin, REQ-UI-003). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _demo_domain = 'messages' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Dashboard Menu',
    home_route: 'app_home',
    repository: 'https://github.com/nowo-tech/DashboardMenuBundle',
    translation_domain: _demo_domain,
    locales: [
        {code: 'en', href: path('app_switch_locale', {_locale: 'en'})},
        {code: 'es', href: path('app_switch_locale', {_locale: 'es'})},
        {code: 'fr', href: path('app_switch_locale', {_locale: 'fr'})},
    ],
    nav: [
        {label: 'demo.home', route: 'app_home'},
        {label: 'demo.manage_menus', route: 'nowo_dashboard_menu_dashboard_index', active: ['nowo_dashboard_menu_dashboard*'], section: 'demo.admin'},
        {label: 'demo.new_menu', route: 'nowo_dashboard_menu_dashboard_menu_new', active: [], section: 'demo.admin'},
        {label: 'demo.api_sidebar', href: path('nowo_dashboard_menu_api', {code: 'sidebar'}), section: 'demo.admin'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.app_title'|trans({}, _demo_domain) }}{% endblock %}{% endblock %}

{% block nowo_ui_demo_platform_header_end %}
    <details class="nowo-ui-menu" data-testid="demo-user-menu">
        <summary class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm">{{ 'demo.user_menu'|trans({}, _demo_domain) }}</summary>
        <div class="nowo-ui-menu__panel nowo-ui-menu__panel--end">
            {% include '_menu.html.twig' with {tree: dashboard_menu_tree('dropdown'), code: 'dropdown', config: dashboard_menu_config('dropdown'), variant: 'aside'} %}
        </div>
    </details>
{% endblock %}


{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoDashboardMenuBundle/_menu_collapse_script.html.twig') }}
{% endblock %}
