{% if nowo_dashboard_ux_autocomplete_available|default(false) %}
{% form_theme form '@SymfonyUXAutocomplete/autocomplete_form_theme.html.twig' %}
{% endif %}
{#-
  Live item form (configuration section). Keep the live#action hooks. cancelHref (2.8): cancel link of the own form
  (full item page, UiKit body-only form page; null = closes the dialog). embedded (2.7): the fields render inside the
  page/form scaffold form element (no own form tag / submit button; the scaffold form posts natively to the edit action),
  every field carries its own data-model binding. Semantic classes + UiKit theme slots only.
-#}
{% set _b = 'NowoDashboardMenuBundle' %}
{% set _muted = nowo_ui_class('muted', _b) %}
{% set _hidden = 'nowo-dashboard-menu-hidden' %}
{% set _embedded = embedded|default(false) %}
{% set _section_focus = sectionFocus|default('') %}
{% set _show_basic = form.basic is defined and (_section_focus == '' or _section_focus == 'basic' or _section_focus == 'identity') %}
{% set _show_icon = form.icon is defined and (_section_focus == '' or _section_focus == 'icon' or _section_focus == 'identity') %}
{% set _show_config = form.config is defined and (_section_focus == 'config' or (_section_focus == '' and isEdit)) %}
<div {{ attributes.defaults({class: 'nowo-dashboard-menu-rows'}) }}>
    {% if app.debug %}
        <div id="dm-livecomponent-debug"
             class="{{ _hidden }}"
             data-php-item-id="{{ this.itemId }}"
             data-php-item-type="{{ this.getItemType() }}"
             data-php-link-type="{{ this.getLinkType() }}"
             data-php-show-link-fields="{{ this.showLinkFields() ? '1' : '0' }}"
             data-php-show-service-fields="{{ this.showServiceLinkFields() ? '1' : '0' }}"
             data-php-show-route-fields="{{ this.showRouteFields() ? '1' : '0' }}"
             data-php-show-external-url="{{ this.showExternalUrlField() ? '1' : '0' }}"
             data-php-item-has-children="{{ this.itemHasChildren ? '1' : '0' }}"
             data-php-translations-count="{{ this.getTranslationsDebug()|length }}"
             data-php-translations-keys="{{ this.getTranslationsKeysDebug() }}"
             data-php-translations-json="{{ this.getTranslationsDebug()|json_encode|e('html_attr') }}"
             data-php-locale-fields-json="{{ this.getLocaleFieldValuesDebug()|json_encode|e('html_attr') }}"
        ></div>
    {% endif %}
    {#
     # Re-render the LiveComponent only when "itemType" changes.
     # This prevents wiping in-progress translation inputs when you switch fields.
    #}
    {% if not _embedded %}
    {{ form_start(form, {
        method: 'POST',
        action: this.actionUrl,
        attr: {
            class: nowo_ui_class('form', _b) ~ ' nowo-dashboard-menu-form',
            'data-model': 'on(change)|*',
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save',
        },
    }) }}
    {% endif %}
        {% if form._section is defined %}
            {{ form_widget(form._section) }}
        {% endif %}
        {% if _show_basic %}
        <div id="item_basic_section" class="nowo-dashboard-menu-fieldset">
            {% set formName = form.vars.name %}
            <h3 class="nowo-dashboard-menu-subheading">{{ 'form.menu_item_type.section_basic'|trans({}, 'NowoDashboardMenuBundle') }}</h3>
            {% if this.getItemType() == 'divider' %}
                <p class="{{ _muted }}">{{ 'form.menu_item_type.divider_label_hint'|trans({}, 'NowoDashboardMenuBundle') }}</p>
            {% endif %}
            <div class="nowo-dashboard-menu-rows">
                <div>
                    {{ form_row(form.basic.label, {attr: {'data-model': 'on(change)|' ~ formName ~ '.basic.label'}}) }}
                </div>
                {% if isEdit and locales is not empty and form.basic.vars.locale_fields is defined %}
                    {#- label_<locale> inputs carry their data-model from MenuItemBasicType (live_model); the active tab
                        survives Live re-renders (UiKit tabs runtime) -#}
                    {{ include('@NowoFormKitBundle/form/_locale_tabs.html.twig', {
                        field: form.basic,
                        fields: form.basic.vars.locale_fields,
                        locales: locales,
                        default_locale: form.basic.vars.default_locale,
                        tabs_id: 'nowo-dashboard-menu-item-labels',
                        testid: 'nowo-dashboard-menu-item-labels',
                        tabs_label: 'form.menu_item_type.labels_by_locale'|trans({}, 'NowoDashboardMenuBundle'),
                        bundle: _b,
                    }, with_context: false) }}
                {% endif %}
            </div>
        </div>
        {% endif %}

        {% if _show_icon %}
        <div id="item_icon_section" class="nowo-dashboard-menu-fieldset">
            {% set formName = form.vars.name %}
            <h3 class="nowo-dashboard-menu-subheading">{{ 'form.menu_item_type.section_icon'|trans({}, 'NowoDashboardMenuBundle') }}</h3>
            <div class="nowo-dashboard-menu-rows">
                <div>
                    {{ form_row(form.icon.itemType, {attr: {'data-model': 'on(change)|' ~ formName ~ '.icon.itemType'}}) }}
                </div>
                {% set positionAttr = {'data-model': 'on(change)|' ~ formName ~ '.icon.position'} %}
                {% if not isEdit %}
                    {% set positionAttr = positionAttr|merge({disabled: 'disabled'}) %}
                {% endif %}
                <div class="{{ isEdit ? '' : _hidden }}">
                    {{ form_row(form.icon.position, {attr: positionAttr}) }}
                </div>
            </div>

            {% set iconAttr = {'data-model': 'on(change)|' ~ formName ~ '.icon.icon'} %}
            {% if not isEdit %}
                {% set iconAttr = iconAttr|merge({disabled: 'disabled'}) %}
            {% endif %}
            <div class="{{ isEdit ? '' : _hidden }}">
                {{ form_row(form.icon.icon, {attr: iconAttr}) }}
            </div>
        </div>
        {% endif %}

        {% if _show_config %}
        <div id="item_config_section" class="nowo-dashboard-menu-fieldset">
            {% set formName = form.vars.name %}
            <h3 class="nowo-dashboard-menu-subheading">{{ 'form.menu_item_type.section_config'|trans({}, 'NowoDashboardMenuBundle') }}</h3>
            {% if form.config.children.parent is defined %}
                {% if this.showParentField() %}
                    {{ form_row(form.config.parent, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.parent'}}) }}
                {% else %}
                    <div class="{{ _hidden }}">{{ form_row(form.config.parent, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.parent'}}) }}</div>
                {% endif %}
            {% endif %}
            {% if form.config.sectionCollapsible is defined %}
                {% if this.showSectionCollapsibleField() %}
                    {% set formName = form.vars.name %}
                    {{ form_row(form.config.sectionCollapsible, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.sectionCollapsible'}}) }}
                {% else %}
                    <div class="{{ _hidden }}">{{ form_row(form.config.sectionCollapsible) }}</div>
                {% endif %}
            {% endif %}
            {% if this.showLinkFields() and form.config.linkType is defined %}
                <div>{{ form_row(form.config.linkType, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.linkType'}}) }}</div>
            {% endif %}
            {% if this.showServiceLinkFields() and form.config.linkResolver is defined %}
                <div id="item_service_link_block" class="nowo-dashboard-menu-rows">
                    {{ form_row(form.config.linkResolver, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.linkResolver'}}) }}
                    {% if form.config.routeParams is defined %}
                        <small class="{{ _muted }}">{{ 'form.menu_item_type.link_resolver.route_params_hint'|trans({}, 'NowoDashboardMenuBundle') }}</small>
                    {% endif %}
                </div>
            {% endif %}
            {% if this.showLinkFields() and form.config.linkType is defined %}
                <div id="item_classic_link_block">
                    {% if form.config.routeName is defined %}
                    <div class="{{ not this.showRouteFields() ? _hidden : '' }}" id="route_name_row">
                        {{ form_row(form.config.routeName, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.routeName'}}) }}
                    </div>
                    {% endif %}
                </div>
                {% if form.config.externalUrl is defined %}
                <div class="{{ not this.showExternalUrlField() ? _hidden : '' }}" id="item_external_link_block">
                    {{ form_row(form.config.externalUrl, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.externalUrl'}}) }}
                </div>
                {% endif %}
            {% endif %}
            {% if (this.showLinkFields() or this.showServiceLinkFields()) and form.config.routeParams is defined %}
                <div
                    class="{% if this.showLinkFields() and not this.showRouteFields() %}{{ _hidden }}{% endif %}"
                    id="route_fields"
                >
                    {{ form_row(form.config.routeParams, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.routeParams'}}) }}
                    {% if this.showRouteFields() %}
                        {% set suggested = this.suggestedRouteParams %}
                        {% if suggested is not empty %}
                            <small class="{{ _muted }}">{{ 'Suggested:'|trans({}, 'NowoDashboardMenuBundle') }} {{ suggested|json_encode(2) }}</small>
                        {% endif %}
                    {% endif %}
                    <small class="{{ _hidden }}" id="route_params_hint" aria-hidden="true"></small>
                </div>
            {% endif %}
            {% if (this.showLinkFields() or this.showServiceLinkFields()) and form.config.targetBlank is defined %}
                {{ form_row(form.config.targetBlank, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.targetBlank'}}) }}
            {% elseif not this.showServiceLinkFields() %}
                <div class="{{ _hidden }}">
                    {% if form.config.linkType is defined %}{{ form_row(form.config.linkType, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.linkType'}}) }}{% endif %}
                    {% if form.config.routeName is defined %}{{ form_row(form.config.routeName, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.routeName'}}) }}{% endif %}
                    {% if form.config.routeParams is defined %}{{ form_row(form.config.routeParams, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.routeParams'}}) }}{% endif %}
                    {% if form.config.externalUrl is defined %}{{ form_row(form.config.externalUrl, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.externalUrl'}}) }}{% endif %}
                    {% if form.config.targetBlank is defined %}{{ form_row(form.config.targetBlank, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.targetBlank'}}) }}{% endif %}
                    {% if form.config.linkResolver is defined %}
                        {{ form_row(form.config.linkResolver, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.linkResolver'}}) }}
                    {% endif %}
                </div>
            {% endif %}
            {% if form.config.permissionKeys is defined %}
                {{ form_row(form.config.permissionKeys, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.permissionKeys'}}) }}
            {% else %}
                {{ form_row(form.config.permissionKey, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.permissionKey'}}) }}
            {% endif %}
            {{ form_row(form.config.isUnanimous, {attr: {'data-model': 'on(change)|' ~ formName ~ '.config.isUnanimous'}}) }}
        </div>
        {% endif %}
        {{ form_rest(form) }}
        {% if not _embedded %}
        <div class="{{ nowo_ui_class('form_actions', _b) }}">
            <button
                type="submit"
                class="{{ nowo_ui_class('btn_primary', _b) }}"
                data-action="live#action:prevent"
                data-live-action-param="save"
            >
                {{ (isEdit ? 'dashboard.update' : 'dashboard.create')|trans({}, 'NowoDashboardMenuBundle') }}
            </button>
            {% if cancelHref|default(null) %}
                <a class="{{ nowo_ui_class('btn_secondary', _b) }}" href="{{ cancelHref }}">{{ 'dashboard.cancel'|trans({}, 'NowoDashboardMenuBundle') }}</a>
            {% else %}
                <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-close>{{ 'dashboard.cancel'|trans({}, 'NowoDashboardMenuBundle') }}</button>
            {% endif %}
        </div>
        {% endif %}
    {% if not _embedded %}{{ form_end(form) }}{% endif %}
</div>
