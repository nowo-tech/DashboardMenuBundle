{% trans_default_domain 'NowoDashboardMenuBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{#
  Shared modals for the dashboard pages (fetch-loaded forms + delete confirmations).
  Shell: dashboard.ui.partials.modal (default _modal.html.twig: Bootstrap markup + semantic nowo-ui-modal, REQ-UI-001).
  Keep the modal ids, the *-body ids and #form-delete-*confirm: dashboard.js targets them.
  Override one modal: point dashboard.ui.templates.modals to a template that extends this one and redefines a dashboard_modal_* block.
#}
{% set _dm_modal = nowo_dashboard_menu_ui.partials.modal ?? '@NowoDashboardMenuBundle/dashboard/_modal.html.twig' %}
{% set _dm_loading_class = dashboard_menu_ui_class('modal_loading', 'text-center py-4 ' ~ ui.muted()) %}

{% block dashboard_modal_menu_form %}
    {% embed _dm_modal with {
        modal_id: 'modal-menu-form',
        modal_label_id: 'modal-menu-form-label',
        modal_title: 'dashboard.edit_menu'|trans,
        modal_body_id: 'modal-menu-form-body',
        modal_size_class: modal_classes.menu_form|default(''),
        modal_kind: 'form',
    } %}
        {% block modal_body %}<div class="{{ _dm_loading_class }}">{{ 'dashboard.loading'|trans({}, 'NowoDashboardMenuBundle') }}</div>{% endblock %}
    {% endembed %}
{% endblock %}

{% block dashboard_modal_menu_copy %}
    {% embed _dm_modal with {
        modal_id: 'modal-menu-copy',
        modal_label_id: 'modal-menu-copy-label',
        modal_title: 'dashboard.copy_menu'|trans,
        modal_body_id: 'modal-menu-copy-body',
        modal_size_class: modal_classes.copy|default(''),
        modal_kind: 'form',
    } %}
        {% block modal_body %}<div class="{{ _dm_loading_class }}">{{ 'dashboard.loading'|trans({}, 'NowoDashboardMenuBundle') }}</div>{% endblock %}
    {% endembed %}
{% endblock %}

{% block dashboard_modal_item_form %}
    {% embed _dm_modal with {
        modal_id: 'modal-item-form',
        modal_label_id: 'modal-item-form-label',
        modal_title: 'dashboard.item'|trans,
        modal_body_id: 'modal-item-form-body',
        modal_size_class: modal_classes.item_form|default('modal-lg'),
        modal_kind: 'form',
    } %}
        {% block modal_body %}<div class="{{ _dm_loading_class }}">{{ 'dashboard.loading'|trans({}, 'NowoDashboardMenuBundle') }}</div>{% endblock %}
    {% endembed %}
{% endblock %}

{% block dashboard_modal_import %}
    {% embed _dm_modal with {
        modal_id: 'modal-import',
        modal_label_id: 'modal-import-label',
        modal_title: 'dashboard.import'|trans,
        modal_body_id: 'modal-import-body',
        modal_size_class: modal_classes.import|default(''),
        modal_kind: 'form',
    } %}
        {% block modal_body %}<div class="{{ _dm_loading_class }}">{{ 'dashboard.loading'|trans({}, 'NowoDashboardMenuBundle') }}</div>{% endblock %}
    {% endembed %}
{% endblock %}

{% block dashboard_modal_delete_menu %}
    {% embed _dm_modal with {
        modal_id: 'modal-delete-confirm',
        modal_label_id: 'modal-delete-label',
        modal_title: 'dashboard.confirm_delete'|trans,
        modal_body_id: '',
        modal_size_class: modal_classes.delete|default(''),
        modal_scrollable: false,
        modal_kind: 'confirm',
        _dm_message_id: 'modal-delete-message',
        _dm_message: 'dashboard.delete_menu_message'|trans,
        _dm_form: delete_menu_modal_form ?? null,
        _dm_form_id: 'form-delete-confirm',
    } %}
        {% block modal_body %}{% include '@NowoDashboardMenuBundle/dashboard/_delete_confirm_body.html.twig' %}{% endblock %}
    {% endembed %}
{% endblock %}

{% block dashboard_modal_delete_item %}
    {% embed _dm_modal with {
        modal_id: 'modal-delete-item-confirm',
        modal_label_id: 'modal-delete-item-label',
        modal_title: 'dashboard.confirm_delete'|trans,
        modal_body_id: '',
        modal_size_class: modal_classes.delete|default(''),
        modal_scrollable: false,
        modal_kind: 'confirm',
        _dm_message_id: 'modal-delete-item-message',
        _dm_message: 'dashboard.delete_item_message'|trans,
        _dm_form: delete_item_modal_form ?? null,
        _dm_form_id: 'form-delete-item-confirm',
    } %}
        {% block modal_body %}{% include '@NowoDashboardMenuBundle/dashboard/_delete_confirm_body.html.twig' %}{% endblock %}
    {% endembed %}
{% endblock %}
