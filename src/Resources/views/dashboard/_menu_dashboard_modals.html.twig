{% trans_default_domain 'NowoDashboardMenuBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{# Modal shells: Bootstrap markup for bootstrap*/tabler; semantic nowo-ui-modal for all frameworks (REQ-UI-001). #}

{# Shared modals for menu show + items reorder pages (fetch-loaded forms). #}
<div class="modal fade nowo-ui-modal" id="modal-menu-form" tabindex="-1" aria-labelledby="modal-menu-form-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable {{ modal_classes.menu_form|default('') }}">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-menu-form-label">{{ 'dashboard.edit_menu'|trans }}</h5>
                <button type="button" class="btn-close" {{ ui.modal_dismiss_attrs()|raw }} aria-label="{{ 'dashboard.close'|trans }}"></button>
            </div>
            <div class="modal-body" id="modal-menu-form-body">
                <div class="text-center py-4 {{ ui.muted() }}">{{ 'dashboard.loading'|trans }}</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade nowo-ui-modal" id="modal-menu-copy" tabindex="-1" aria-labelledby="modal-menu-copy-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable {{ modal_classes.copy|default('') }}">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-menu-copy-label">{{ 'dashboard.copy_menu'|trans }}</h5>
                <button type="button" class="btn-close" {{ ui.modal_dismiss_attrs()|raw }} aria-label="{{ 'dashboard.close'|trans }}"></button>
            </div>
            <div class="modal-body" id="modal-menu-copy-body">
                <div class="text-center py-4 {{ ui.muted() }}">{{ 'dashboard.loading'|trans }}</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade nowo-ui-modal" id="modal-item-form" tabindex="-1" aria-labelledby="modal-item-form-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable {{ modal_classes.item_form|default('modal-lg') }}">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-item-form-label">{{ 'dashboard.item'|trans }}</h5>
                <button type="button" class="btn-close" {{ ui.modal_dismiss_attrs()|raw }} aria-label="{{ 'dashboard.close'|trans }}"></button>
            </div>
            <div class="modal-body" id="modal-item-form-body">
                <div class="text-center py-4 {{ ui.muted() }}">{{ 'dashboard.loading'|trans }}</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade nowo-ui-modal" id="modal-import" tabindex="-1" aria-labelledby="modal-import-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable {{ modal_classes.import|default('') }}">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-import-label">{{ 'dashboard.import'|trans }}</h5>
                <button type="button" class="btn-close" {{ ui.modal_dismiss_attrs()|raw }} aria-label="{{ 'dashboard.close'|trans }}"></button>
            </div>
            <div class="modal-body" id="modal-import-body">
                <div class="text-center py-4 {{ ui.muted() }}">{{ 'dashboard.loading'|trans }}</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade nowo-ui-modal" id="modal-delete-confirm" tabindex="-1" aria-labelledby="modal-delete-label" aria-hidden="true">
    <div class="modal-dialog {{ modal_classes.delete|default('') }}">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-delete-label">{{ 'dashboard.confirm_delete'|trans }}</h5>
                <button type="button" class="btn-close" {{ ui.modal_dismiss_attrs()|raw }} aria-label="{{ 'dashboard.close'|trans }}"></button>
            </div>
            <div class="modal-body">
                <p id="modal-delete-message">{{ 'dashboard.delete_menu_message'|trans }}</p>
                <form id="form-delete-confirm" method="post" action="">
                    <input type="hidden" name="_token" value="">
                    <div class="{{ ui.row_actions() }}" style="justify-content:flex-end;">
                        <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans }}</button>
                        <button type="submit" class="{{ ui.btn('danger') }}">{{ 'dashboard.delete'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade nowo-ui-modal" id="modal-delete-item-confirm" tabindex="-1" aria-labelledby="modal-delete-item-label" aria-hidden="true">
    <div class="modal-dialog {{ modal_classes.delete|default('') }}">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-delete-item-label">{{ 'dashboard.confirm_delete'|trans }}</h5>
                <button type="button" class="btn-close" {{ ui.modal_dismiss_attrs()|raw }} aria-label="{{ 'dashboard.close'|trans }}"></button>
            </div>
            <div class="modal-body">
                <p id="modal-delete-item-message">{{ 'dashboard.delete_item_message'|trans }}</p>
                <form id="form-delete-item-confirm" method="post" action="">
                    <input type="hidden" name="_token" value="">
                    <div class="{{ ui.row_actions() }}" style="justify-content:flex-end;">
                        <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans }}</button>
                        <button type="submit" class="{{ ui.btn('danger') }}">{{ 'dashboard.delete'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
