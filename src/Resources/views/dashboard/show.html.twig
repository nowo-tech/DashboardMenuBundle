{#
  Menu detail (REQ-UI-003): UiKit show scaffold. View model: page (ShowPage from DashboardPages::showPage():
  properties + CSS classes as detail sections, header actions). Extra context: menu, item_columns (list<Column>),
  item_rows (DashboardPages::itemRows(): item, depth, parentLabel, actions), add_item (Action), current_locale,
  dialogs. Data blocks: nowo_ui_show_after → nowo_dashboard_menu_items (items table, theme slots of the list
  scaffold) with nowo_dashboard_menu_item_cells (cells of one row: row, item, depth). Override per page:
  nowo_dashboard_menu.web_ui.templates.show.
#}
{% extends '@NowoUiKit/page/show.html.twig' %}

{% block nowo_ui_show_after %}
    {% block nowo_dashboard_menu_items %}
        {% set _b = page.bundle %}
        <section class="{{ nowo_ui_class('section', _b) }} nowo-dashboard-menu-items" data-testid="dashboard-menu-items">
            {% if item_rows is empty %}
                <div class="{{ nowo_ui_class('empty', _b) }}" data-nowo-ui-region="empty"{{ nowo_ui_attrs('empty', _b) }}>
                    <p>{{ 'dashboard.no_items'|trans({}, 'NowoDashboardMenuBundle') }}</p>
                    {% if add_item|default(null) %}
                        {{ include(nowo_ui_partial('action', _b), {action: add_item, context: 'toolbar', bundle: _b}, false) }}
                    {% endif %}
                </div>
            {% else %}
                <div class="{{ nowo_ui_class('table_wrap', _b) }}" data-nowo-ui-region="table" data-nowo-ui-responsive="cards"{{ nowo_ui_attrs('table_wrap', _b) }}>
                    <table class="{{ nowo_ui_class('table', _b) }} nowo-ui-table--cards"{{ nowo_ui_attrs('table', _b) }}>
                        <thead class="{{ nowo_ui_class('table_head', _b) }}">
                            <tr class="{{ nowo_ui_class('table_head_row', _b) }}">
                                {% for column in item_columns %}
                                    <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }} nowo-ui-cell--{{ column.align }}"{% if column.required %} data-required="1"{% elseif column.priority %} data-nowo-ui-priority="{{ column.priority }}"{% endif %}>{{ column.label|nowo_ui_trans }}</th>
                                {% endfor %}
                                <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }} {{ nowo_ui_class('table_actions_head', _b) }} nowo-ui-cell--end">{{ 'dashboard.actions'|trans({}, 'NowoDashboardMenuBundle') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row_key, row in item_rows %}
                                {% set item = row.item %}
                                {% set depth = row.depth %}
                                <tr id="item-{{ item.id }}" class="{{ nowo_ui_class('table_row', _b) }}">
                                    {% block nowo_dashboard_menu_item_cells %}
                                        {% set _cell = nowo_ui_class('table_cell', _b) %}
                                        {% set _muted = nowo_ui_class('muted', _b) %}
                                        {% set _label = item.getLabelForLocale(current_locale|default('en')) ?: ('dashboard.no_label'|trans({}, 'NowoDashboardMenuBundle')) %}
                                        <td class="{{ _cell }}" data-label="{{ item_columns[0].label|nowo_ui_trans }}" data-nowo-ui-priority="3">
                                            <div>{{ row.parentLabel }}</div>
                                            <div class="{{ _muted }}">{{ 'dashboard.position_short'|trans({}, 'NowoDashboardMenuBundle') }}: {{ item.position }}</div>
                                        </td>
                                        <td class="{{ _cell }}" data-label="{{ item_columns[1].label|nowo_ui_trans }}">
                                            {{ include('@NowoDashboardMenuBundle/dashboard/_dashboard_item_icon.html.twig', {item: item}, false) }}
                                            {{ _label }}
                                        </td>
                                        <td class="{{ _cell }}" data-label="{{ item_columns[2].label|nowo_ui_trans }}" data-nowo-ui-priority="2">
                                            {% if item.itemType == 'link' and item.linkType == 'route' and item.routeName %}
                                                <code class="{{ nowo_ui_class('code', _b) }}">{{ item.routeName }}{% if item.routeParams and item.routeParams|length > 0 %} {{ item.routeParams|json_encode }}{% endif %}</code>
                                            {% elseif item.itemType == 'link' and item.externalUrl %}
                                                <a href="{{ item.externalUrl }}" target="_blank" rel="noopener noreferrer">{{ item.externalUrl }}</a>
                                            {% else %}
                                                <span class="{{ _muted }}">—</span>
                                            {% endif %}
                                            <div class="nowo-dashboard-menu-permissions">
                                                {% for permission_key in item.permissionKeys ?? [] %}
                                                    <code class="{{ nowo_ui_class('code', _b) }}">{{ permission_key }}</code>
                                                {% else %}
                                                    <span class="{{ _muted }}">{{ 'dashboard.no_permission_keys'|trans({}, 'NowoDashboardMenuBundle') }}</span>
                                                {% endfor %}
                                                {% if item.isUnanimous %}
                                                    <span class="{{ nowo_ui_class('badge_success', _b) }}">{{ 'dashboard.unanimous'|trans({}, 'NowoDashboardMenuBundle') }}</span>
                                                {% else %}
                                                    <span class="{{ nowo_ui_class('badge_warning', _b) }}">{{ 'dashboard.non_unanimous'|trans({}, 'NowoDashboardMenuBundle') }}</span>
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td class="{{ _cell }} nowo-dashboard-menu-item-cell nowo-dashboard-menu-depth-{{ depth }}" data-label="{{ item_columns[3].label|nowo_ui_trans }}" style="padding-inline-start: {{ 0.5 + depth * 1.25 }}rem;">
                                            {{ include('@NowoDashboardMenuBundle/dashboard/_dashboard_item_icon.html.twig', {item: item}, false) }}
                                            <span class="{{ nowo_ui_class('badge_neutral', _b) }} nowo-dashboard-menu-badge--type">{{ item.itemType }}</span>
                                            {{ _label }}
                                        </td>
                                    {% endblock %}
                                    <td class="{{ nowo_ui_class('table_cell', _b) }} {{ nowo_ui_class('table_actions_cell', _b) }} nowo-ui-cell--end">
                                        {{ include(nowo_ui_partial('row_actions', _b), {actions: row.actions|map(a => a.withConfirmScope(row_key)), bundle: _b}, false) }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    {% endblock %}
{% endblock %}

{% block nowo_ui_styles %}{{ parent() }}{{ include('@NowoDashboardMenuBundle/dashboard/_page_styles.html.twig') }}{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {{ include('@NowoDashboardMenuBundle/dashboard/_dialogs.html.twig', {dialogs: dialogs|default([]), bundle: page.bundle}) }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoDashboardMenuBundle/dashboard/_page_scripts.html.twig', {
        page_config: {baseUrl: path('nowo_dashboard_menu_dashboard_show', {id: menu.id}), menuId: menu.id, debug: app is defined and app ? app.debug : false},
    }) }}
{% endblock %}
