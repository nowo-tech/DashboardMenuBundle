{% extends '@NowoDashboardMenuBundle/dashboard/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% import '@NowoDashboardMenuBundle/dashboard/_icons.html.twig' as icons %}

{% block dashboard_title %}{{ 'dashboard.menu'|trans({}, 'NowoDashboardMenuBundle') }}: {{ menu.code }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a href="{{ path(dashboard_routes.index|default('nowo_dashboard_menu_dashboard_index')) }}" class="{{ ui.btn('link') }}">{{ 'dashboard.menus_back'|trans({}, 'NowoDashboardMenuBundle') }}</a>
            <h1 class="h3 d-inline">{% if menu.icon %}<span class="{{ ui.muted() }} me-1" title="{{ menu.icon }}">🔣</span>{% endif %}{{ menu.code }}{% if menu.name %} <span class="{{ ui.muted() }}">({{ menu.name }})</span>{% endif %}</h1>
            {% if items|length > 0 %}
                <a href="{{ path(dashboard_routes.show_items_reorder|default('nowo_dashboard_menu_dashboard_show_items_reorder'), { id: menu.id }) }}" class="{{ ui.btn('secondary', 'sm') }}">{{ 'dashboard.open_sortable_reorder'|trans({}, 'NowoDashboardMenuBundle') }}</a>
            {% endif %}
        </div>
        <div class="{{ ui.row_actions() }} flex-wrap justify-content-end">
            <a href="{{ path(dashboard_routes.export_menu|default('nowo_dashboard_menu_dashboard_export_menu'), { id: menu.id }) }}" class="{{ ui.btn('secondary') }}" target="_blank" rel="noopener noreferrer">{{ 'dashboard.export'|trans({}, 'NowoDashboardMenuBundle') }}</a>
            <button type="button" class="{{ ui.btn('secondary') }} btn-copy-menu" data-id="{{ menu.id }}" data-copy-url="{{ path(dashboard_routes.menu_copy|default('nowo_dashboard_menu_dashboard_menu_copy'), { id: menu.id }) }}" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-menu-copy')|raw }}>{{ 'dashboard.copy'|trans({}, 'NowoDashboardMenuBundle') }}</button>
            <button type="button" class="{{ ui.btn('primary') }} btn-edit-menu" data-id="{{ menu.id }}" data-section="basic" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-menu-form')|raw }} title="{{ 'dashboard.edit_identity'|trans({}, 'NowoDashboardMenuBundle') }}">{{ 'dashboard.edit_menu'|trans({}, 'NowoDashboardMenuBundle') }}</button>
            {% if not menu.base %}
                <button type="button" class="{{ ui.btn('secondary') }} btn-edit-menu btn-edit-menu-config" data-id="{{ menu.id }}" data-section="config" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-menu-form')|raw }} title="{{ 'dashboard.edit_config'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.edit_config'|trans({}, 'NowoDashboardMenuBundle') }}">
                    {{ icons.config()|raw }}
                </button>
            {% endif %}
            {% if items|length > 0 %}
                <form method="post" action="{{ path(dashboard_routes.items_reindex_positions|default('nowo_dashboard_menu_dashboard_items_reindex_positions'), { id: menu.id }) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('reindex_positions_' ~ menu.id) }}">
                    <button type="submit" class="{{ ui.btn('secondary') }}" title="{{ 'dashboard.reindex_positions_title'|trans({'%step%': position_step}, 'NowoDashboardMenuBundle') }}">
                        {{ 'dashboard.reindex_positions'|trans({'%step%': position_step}, 'NowoDashboardMenuBundle') }}
                    </button>
                </form>
                <form method="post" action="{{ path(dashboard_routes.items_check_parent_cycles|default('nowo_dashboard_menu_dashboard_items_check_parent_cycles'), { id: menu.id }) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('check_parent_cycles_' ~ menu.id) }}">
                    <button type="submit" class="{{ ui.btn('secondary') }}" title="{{ 'dashboard.check_parent_cycles_title'|trans({}, 'NowoDashboardMenuBundle') }}">
                        {{ 'dashboard.check_parent_cycles'|trans({}, 'NowoDashboardMenuBundle') }}
                    </button>
                </form>
            {% endif %}
            <button type="button" class="{{ ui.btn('primary') }} btn-add-item" data-id="{{ menu.id }}" data-parent="" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-item-form')|raw }}>{{ 'dashboard.add_item'|trans({}, 'NowoDashboardMenuBundle') }}</button>
        </div>
    </div>

    {% if menu.permissionChecker or menu.depthLimit is not null or menu.collapsible is not null or menu.collapsibleExpanded is not null or menu.nestedCollapsible is not null or menu.nestedCollapsibleSections is not null %}
        <div class="alert alert-light border mb-2 py-2">
            {% if menu.permissionChecker %}<strong>{{ 'dashboard.permission_checker'|trans({}, 'NowoDashboardMenuBundle') }}:</strong> <code>{{ menu.permissionChecker }}</code>{% endif %}
            {% if menu.depthLimit is not null %} {% if menu.permissionChecker %}·{% endif %} <strong>{{ 'dashboard.depth_limit'|trans({}, 'NowoDashboardMenuBundle') }}:</strong> {{ menu.depthLimit }}{% endif %}
            {% if menu.collapsible is not null %} · <strong>{{ 'dashboard.collapsible'|trans({}, 'NowoDashboardMenuBundle') }}:</strong> {{ menu.collapsible ? 'dashboard.yes'|trans : 'dashboard.no'|trans({}, 'NowoDashboardMenuBundle') }}{% endif %}
            {% if menu.collapsibleExpanded is not null %} · <strong>{{ 'dashboard.collapsible_expanded'|trans({}, 'NowoDashboardMenuBundle') }}:</strong> {{ menu.collapsibleExpanded ? 'dashboard.yes'|trans : 'dashboard.no'|trans({}, 'NowoDashboardMenuBundle') }}{% endif %}
            {% if menu.nestedCollapsible is not null %} · <strong>{{ 'dashboard.nested_collapsible'|trans({}, 'NowoDashboardMenuBundle') }}:</strong> {{ menu.nestedCollapsible ? 'dashboard.yes'|trans : 'dashboard.no'|trans({}, 'NowoDashboardMenuBundle') }}{% endif %}
            {% if menu.nestedCollapsibleSections is not null %} · <strong>{{ 'form.menu_type.nested_collapsible_sections.label'|trans({}, 'NowoDashboardMenuBundle') }}:</strong> {{ menu.nestedCollapsibleSections ? 'dashboard.yes'|trans : 'dashboard.no'|trans({}, 'NowoDashboardMenuBundle') }}{% endif %}
        </div>
    {% endif %}
    {% if menu.ulId or menu.classMenu or menu.classItem or menu.classLink or menu.classChildren or menu.classSectionChildren or menu.classSectionChildItem or menu.classSectionChildLink or menu.classSectionLabel or menu.classSection or menu.classDivider or menu.classCurrent or menu.classBranchExpanded or menu.classHasChildren or menu.classExpanded or menu.classCollapsed %}
        <div class="alert alert-light border mb-2 py-2">
            <strong>{{ 'dashboard.css_classes'|trans({}, 'NowoDashboardMenuBundle') }}</strong>: {% if menu.classMenu %}<code>menu: {{ menu.classMenu }}</code>{% endif %}
            {% if menu.ulId %}<code>ul_id: {{ menu.ulId }}</code>{% endif %}
            {% if menu.classItem %} <code>item: {{ menu.classItem }}</code>{% endif %}
            {% if menu.classLink %} <code>link: {{ menu.classLink }}</code>{% endif %}
            {% if menu.classChildren %} <code>children: {{ menu.classChildren }}</code>{% endif %}
            {% if menu.classSectionChildren %} <code>section-children: {{ menu.classSectionChildren }}</code>{% endif %}
            {% if menu.classSectionChildItem %} <code>section-child-item: {{ menu.classSectionChildItem }}</code>{% endif %}
            {% if menu.classSectionChildLink %} <code>section-child-link: {{ menu.classSectionChildLink }}</code>{% endif %}
            {% if menu.classSectionLabel %} <code>section-label: {{ menu.classSectionLabel }}</code>{% endif %}
            {% if menu.classSection %} <code>section: {{ menu.classSection }}</code>{% endif %}
            {% if menu.classDivider %} <code>divider: {{ menu.classDivider }}</code>{% endif %}
            {% if menu.classCurrent %} <code>current: {{ menu.classCurrent }}</code>{% endif %}
            {% if menu.classBranchExpanded %} <code>branch: {{ menu.classBranchExpanded }}</code>{% endif %}
            {% if menu.classHasChildren %} <code>has-children: {{ menu.classHasChildren }}</code>{% endif %}
            {% if menu.classExpanded %} <code>expanded: {{ menu.classExpanded }}</code>{% endif %}
            {% if menu.classCollapsed %} <code>collapsed: {{ menu.classCollapsed }}</code>{% endif %}
        </div>
    {% endif %}

    {% if items|length == 0 %}
        <p class="{{ ui.empty() }}">{{ 'dashboard.no_items'|trans({}, 'NowoDashboardMenuBundle') }} <button type="button" class="{{ ui.btn('link') }} p-0 align-baseline btn-add-item" data-id="{{ menu.id }}" data-parent="" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-item-form')|raw }}>{{ 'dashboard.add_one'|trans({}, 'NowoDashboardMenuBundle') }}</button>.</p>
    {% else %}
        {% set currentLocale = app.request.locale|default('en') %}
        <style>
            .nowo-dashboard-menu-actions-col { width: 1%; white-space: nowrap; }
            .nowo-dashboard-menu-move-stack { display: inline-flex; flex-direction: column; gap: .25rem; }
            .nowo-dashboard-menu-actions { display: inline-flex; align-items: center; gap: .5rem; }
            .nowo-dashboard-menu-actions .btn { padding-left: .4rem; padding-right: .4rem; }
            .nowo-dashboard-menu-route { min-width: 18rem; }
            @media (max-width: 992px) { .nowo-dashboard-menu-route { min-width: 14rem; } }
        </style>
        <div class="{{ ui.table_wrap() }}">
            <table class="{{ ui.table() }}">
                <thead>
                    <tr>
                        <th class="nowo-dashboard-menu-actions-col">{{ 'dashboard.actions'|trans({}, 'NowoDashboardMenuBundle') }}</th>
                        <th style="width: 1%; white-space: nowrap;">{{ 'dashboard.parent'|trans({}, 'NowoDashboardMenuBundle') }}</th>
                        <th style="white-space: nowrap;">Label ({{ currentLocale }})</th>
                        <th class="nowo-dashboard-menu-route" style="white-space: nowrap;">{{ 'dashboard.route_url'|trans({}, 'NowoDashboardMenuBundle') }}</th>
                        <th>{{ 'dashboard.item'|trans({}, 'NowoDashboardMenuBundle') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        {% set depth = item_depths[item.id] is defined ? item_depths[item.id] : 0 %}
                        <tr id="item-{{ item.id }}">
                            <td class="nowo-dashboard-menu-actions-col">
                                <div class="nowo-dashboard-menu-actions">
                                    <div class="nowo-dashboard-menu-move-stack" aria-label="{{ 'dashboard.actions'|trans({}, 'NowoDashboardMenuBundle') }}">
                                        {% if prev_sibling[item.id] is defined and prev_sibling[item.id] is not null %}
                                            <form method="post" action="{{ path(dashboard_routes.item_move_up|default('nowo_dashboard_menu_dashboard_item_move_up'), { id: menu.id, itemId: item.id }) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('item_move_up_' ~ item.id) }}">
                                                <button type="submit" class="{{ ui.btn('secondary', 'sm') }}" title="{{ 'dashboard.move_up'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.move_up'|trans({}, 'NowoDashboardMenuBundle') }}">
                                                    {{ icons.arrow_up()|raw }}
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="{{ ui.btn('secondary', 'sm') }} disabled" title="{{ 'dashboard.first'|trans({}, 'NowoDashboardMenuBundle') }}" aria-hidden="true">
                                                {{ icons.arrow_up()|raw }}
                                            </span>
                                        {% endif %}
                                        {% if next_sibling[item.id] is defined and next_sibling[item.id] is not null %}
                                            <form method="post" action="{{ path(dashboard_routes.item_move_down|default('nowo_dashboard_menu_dashboard_item_move_down'), { id: menu.id, itemId: item.id }) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('item_move_down_' ~ item.id) }}">
                                                <button type="submit" class="{{ ui.btn('secondary', 'sm') }}" title="{{ 'dashboard.move_down'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.move_down'|trans({}, 'NowoDashboardMenuBundle') }}">
                                                    {{ icons.arrow_down()|raw }}
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="{{ ui.btn('secondary', 'sm') }} disabled" title="{{ 'dashboard.last'|trans({}, 'NowoDashboardMenuBundle') }}" aria-hidden="true">
                                                {{ icons.arrow_down()|raw }}
                                            </span>
                                        {% endif %}
                                    </div>
                                    <div class="d-inline-flex align-items-center gap-1">
                                        {% set can_have_children = item.itemType == 'link' or item.itemType == 'service' %}
                                        <button type="button" class="{{ ui.btn('primary', 'sm') }} btn-add-item{% if not can_have_children %} disabled{% endif %}" title="{{ can_have_children ? 'dashboard.add_child'|trans({}, 'NowoDashboardMenuBundle') : 'dashboard.add_child_disabled'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.add_child'|trans({}, 'NowoDashboardMenuBundle') }}" {% if can_have_children %}data-id="{{ menu.id }}" data-parent="{{ item.id }}" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-item-form')|raw }}{% else %}disabled aria-disabled="true"{% endif %}>
                                            {{ icons.add()|raw }}
                                        </button>
                                        <button type="button" class="{{ ui.action('edit') }} btn-edit-item" title="{{ 'dashboard.edit_labels'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.edit_labels'|trans({}, 'NowoDashboardMenuBundle') }}" data-id="{{ menu.id }}" data-item-id="{{ item.id }}" data-section="basic" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-item-form')|raw }}>
                                            {{ icons.edit()|raw }}
                                        </button>
                                        <button type="button" class="{{ ui.action('edit') }} btn-edit-item" title="{{ 'dashboard.edit_type_position_icon'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.edit_type_position_icon'|trans({}, 'NowoDashboardMenuBundle') }}" data-id="{{ menu.id }}" data-item-id="{{ item.id }}" data-section="icon" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-item-form')|raw }}>
                                            {{ icons.items()|raw }}
                                        </button>
                                        <button type="button" class="{{ ui.action('edit') }} btn-edit-item btn-edit-item-config" title="{{ 'dashboard.edit_config'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.edit_config'|trans({}, 'NowoDashboardMenuBundle') }}" data-id="{{ menu.id }}" data-item-id="{{ item.id }}" data-section="config" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-item-form')|raw }}>
                                            {{ icons.config()|raw }}
                                        </button>
                                        <button type="button" class="{{ ui.action('delete') }} btn-delete-item" title="{{ 'dashboard.delete'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.delete'|trans({}, 'NowoDashboardMenuBundle') }}" data-id="{{ menu.id }}" data-item-id="{{ item.id }}" data-name="{{ item.getLabelForLocale(currentLocale) ?: ('dashboard.no_label'|trans({}, 'NowoDashboardMenuBundle')) }}" data-url="{{ path(dashboard_routes.item_delete|default('nowo_dashboard_menu_dashboard_item_delete'), { id: menu.id, itemId: item.id }) }}" data-token="{{ csrf_token('delete_item_' ~ item.id) }}" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-delete-item-confirm')|raw }}>
                                            {{ icons.trash()|raw }}
                                        </button>
                                    </div>
                                </div>
                            </td>
                            <td class="{{ ui.muted() }} small">
                                <div>{{ item_parent_labels[item.id] is defined ? item_parent_labels[item.id] : '—' }}</div>
                                <div class="small text-secondary">Pos: {{ item.position }}</div>
                            </td>
                            <td class="small">
                                {% include '@NowoDashboardMenuBundle/dashboard/_dashboard_item_icon.html.twig' with { item: item } only %}
                                {{ item.getLabelForLocale(currentLocale) ?: ('dashboard.no_label'|trans({}, 'NowoDashboardMenuBundle')) }}
                            </td>
                            <td class="small">
                                {% if item.itemType == 'link' %}
                                    {% if item.linkType == 'route' and item.routeName %}
                                        <code class="d-block {{ ui.muted() }}">{{ item.routeName }}{% if item.routeParams and item.routeParams|length > 0 %} {{ item.routeParams|json_encode }}{% endif %}</code>
                                    {% elseif item.externalUrl %}
                                        <a href="{{ item.externalUrl }}" target="_blank" rel="noopener noreferrer" class="text-break">{{ item.externalUrl }}</a>
                                    {% else %}
                                        <span class="{{ ui.muted() }}">—</span>
                                    {% endif %}
                                {% else %}
                                    <span class="{{ ui.muted() }}">—</span>
                                {% endif %}
                                {% set _permission_keys = item.permissionKeys ?? [] %}
                                <div class="mt-1">
                                    {% if _permission_keys is iterable and _permission_keys|length > 0 %}
                                        {% for permission_key in _permission_keys %}
                                            <code class="me-1">{{ permission_key }}</code>
                                        {% endfor %}
                                    {% else %}
                                        <span class="{{ ui.muted() }}">No permission keys</span>
                                    {% endif %}
                                </div>
                                <div class="mt-1">
                                    {% if item.isUnanimous %}
                                        <span class="badge bg-success">Unanimous</span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark">Non-unanimous</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td style="padding-left: {{ 0.5 + depth * 1.25 }}rem;">
                                {% include '@NowoDashboardMenuBundle/dashboard/_dashboard_item_icon.html.twig' with { item: item } only %}
                                <span class="badge bg-secondary me-2">{{ item.itemType }}</span>
                                {{ item.getLabelForLocale(currentLocale) ?: ('dashboard.no_label'|trans({}, 'NowoDashboardMenuBundle')) }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <script>
    window.__nowoDashboardMenuConfig = Object.assign(window.__nowoDashboardMenuConfig || {}, {
        baseUrl: {{ path(dashboard_show_route|default(dashboard_routes.show|default('nowo_dashboard_menu_dashboard_show')), { id: menu.id }) |json_encode|raw }},
        menuId: {{ menu.id }},
        debug: {{ app.debug ? 'true' : 'false' }}
    });
    </script>
{% endblock %}
