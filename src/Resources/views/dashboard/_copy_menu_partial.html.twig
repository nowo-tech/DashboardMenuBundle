{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{#- Chrome: dashboard.ui.classes.{modal_form, modal_content, modal_actions, button_primary, button_secondary, muted}, dashboard.ui.form_themes. -#}
{% set _dm_ui = nowo_dashboard_menu_ui|default({}) %}
{% if _dm_ui.form_themes|default([]) is not empty %}{% form_theme form with _dm_ui.form_themes %}{% endif %}
{% for msg in app.flashes('error') %}
    <div class="{{ ui.flash('error') }}">{{ msg }}</div>
{% endfor %}
<p class="{{ dashboard_menu_ui_class('muted', ui.muted()) }} small">{{ 'dashboard.copy_menu_help'|trans({}, 'NowoDashboardMenuBundle') }}</p>
{% set _dm_form_attr = { class: dashboard_menu_ui_class('modal_form', 'form form-vertical') ~ ' dm-dashboard-form' } %}
{% if _dm_ui.classes.modal_form is not defined %}{% set _dm_form_attr = _dm_form_attr|merge({ style: 'max-width: 32rem;' }) %}{% endif %}
{{ form_start(form, { attr: _dm_form_attr }) }}
    <div class="{{ dashboard_menu_ui_class('modal_content', 'row mb-2') }}">
        {% for field in form.children %}
            {{ form_row(field) }}
        {% endfor %}
    </div>
    {% if _dm_ui.classes.modal_actions is defined %}
    <div class="{{ _dm_ui.classes.modal_actions }}">
        <button type="button" class="{{ dashboard_menu_ui_class('button_secondary', ui.btn('secondary')) }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans({}, 'NowoDashboardMenuBundle') }}</button>
        <button type="submit" class="{{ dashboard_menu_ui_class('button_primary', ui.btn('primary')) }}">{{ 'dashboard.copy_menu'|trans({}, 'NowoDashboardMenuBundle') }}</button>
    </div>
    {% else %}
    <button type="submit" class="{{ dashboard_menu_ui_class('button_primary', ui.btn('primary')) }}">{{ 'dashboard.copy_menu'|trans({}, 'NowoDashboardMenuBundle') }}</button>
    <button type="button" class="{{ dashboard_menu_ui_class('button_secondary', ui.btn('secondary')) }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans({}, 'NowoDashboardMenuBundle') }}</button>
    {% endif %}
{{ form_end(form) }}
