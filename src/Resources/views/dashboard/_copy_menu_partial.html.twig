{#- Copy menu dialog fragment (GET ?_modal=1). Variables: form, menu. Override: web_ui.templates.copy_menu_partial. -#}
{% set _b = 'NowoDashboardMenuBundle' %}
<p class="{{ nowo_ui_class('muted', _b) }}">{{ 'dashboard.copy_menu_help'|trans({}, 'NowoDashboardMenuBundle') }}</p>
{{ form_start(form, {attr: {class: nowo_ui_class('form', _b) ~ ' nowo-dashboard-menu-form'}}) }}
    {% for field in form %}
        {% if not field.rendered %}{{ form_row(field) }}{% endif %}
    {% endfor %}
    {{ include('@NowoDashboardMenuBundle/dashboard/_dialog_form_actions.html.twig', {submit_label: 'dashboard.copy_menu'|trans({}, 'NowoDashboardMenuBundle'), bundle: _b}) }}
{{ form_end(form) }}
