{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% for msg in app.flashes('error') %}
    <div class="{{ ui.flash('error') }}">{{ msg }}</div>
{% endfor %}
<p class="{{ ui.muted() }} small">{{ 'dashboard.copy_menu_help'|trans({}, 'NowoDashboardMenuBundle') }}</p>
{{ form_start(form, { attr: { class: 'form form-vertical dm-dashboard-form', style: 'max-width: 32rem;' } }) }}
    <div class="row mb-2">
        {% for field in form.children %}
            {{ form_row(field) }}
        {% endfor %}
    </div>
    <button type="submit" class="{{ ui.btn('primary') }}">{{ 'dashboard.copy_menu'|trans({}, 'NowoDashboardMenuBundle') }}</button>
    <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans({}, 'NowoDashboardMenuBundle') }}</button>
{{ form_end(form) }}
