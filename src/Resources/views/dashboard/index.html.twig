{% extends '@NowoDashboardMenuBundle/dashboard/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% import '@NowoDashboardMenuBundle/dashboard/_icons.html.twig' as icons %}

{% block dashboard_title %}{{ 'dashboard.menus'|trans({}, 'NowoDashboardMenuBundle') }}{% endblock %}

{% block body %}
    {{ form_start(search_form, { attr: { class: ui.search_form(), role: 'search' } }) }}
        {{ form_widget(search_form.q, { attr: { class: ui.search_input() } }) }}
        <button type="submit" class="{{ ui.btn('secondary') }}">{{ 'dashboard.filter'|trans({}, 'NowoDashboardMenuBundle') }}</button>
        <a href="{{ path(dashboard_routes.index|default('nowo_dashboard_menu_dashboard_index')) }}" class="{{ ui.btn('secondary') }}">{{ 'dashboard.clear_filters'|trans({}, 'NowoDashboardMenuBundle') }}</a>
    {{ form_end(search_form) }}

    <div class="{{ ui.toolbar() }}">
        <a href="{{ path(dashboard_routes.export_all|default('nowo_dashboard_menu_dashboard_export_all')) }}" class="{{ ui.btn('secondary') }}" target="_blank" rel="noopener noreferrer">{{ 'dashboard.export_all'|trans({}, 'NowoDashboardMenuBundle') }}</a>
        <button type="button" class="{{ ui.btn('secondary') }} btn-import" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-import')|raw }} data-import-url="{{ path(dashboard_routes.import|default('nowo_dashboard_menu_dashboard_import')) }}">{{ 'dashboard.import'|trans({}, 'NowoDashboardMenuBundle') }}</button>
        <button type="button" class="{{ ui.btn('primary') }}" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-menu-new')|raw }}>{{ 'dashboard.new_menu'|trans({}, 'NowoDashboardMenuBundle') }}</button>
    </div>

    {% if menus|length == 0 %}
        <p class="{{ ui.empty() }}">{{ 'dashboard.no_menus_yet'|trans({}, 'NowoDashboardMenuBundle') }}</p>
    {% else %}
        <ul class="{{ ui.list() }}">
            {% for menu in menus %}
                <li class="{{ ui.list_item() }}">
                    <div>
                        {% if menu.icon %}<span class="{{ ui.muted() }} me-1" title="{{ menu.icon }}">🔣</span>{% endif %}
                        <strong>{{ menu.code }}</strong>
                        {% set _itemsCount = menu_item_counts[menu.id]|default(0) %}
                        <span class="{{ ui.badge() }}" title="{{ _itemsCount }}">{{ _itemsCount }}</span>
                        {% if menu.base %}<span class="badge bg-secondary ms-1" title="{{ 'dashboard.base_badge_title'|trans({}, 'NowoDashboardMenuBundle') }}">{{ 'dashboard.base'|trans({}, 'NowoDashboardMenuBundle') }}</span>{% endif %}
                        {% if menu.name %}<span class="{{ ui.muted() }}"> — {{ menu.name }}</span>{% endif %}
                        {% if menu.context is defined and menu.context is iterable and menu.context is not empty %}
                            <br><span class="small {{ ui.muted() }}">{{ 'dashboard.context'|trans({}, 'NowoDashboardMenuBundle') }}: {{ menu.context|keys|join(', ') }}</span>
                        {% endif %}
                    </div>
                    <div class="{{ ui.row_actions() }}">
                        <a href="{{ path(dashboard_show_route|default(dashboard_routes.show|default('nowo_dashboard_menu_dashboard_show')), { id: menu.id }) }}" class="{{ ui.action('view') }}" title="{{ 'dashboard.edit_items'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.edit_items'|trans({}, 'NowoDashboardMenuBundle') }}">
                            {{ icons.items()|raw }}
                        </a>
                        <button type="button" class="{{ ui.action('edit') }} btn-copy-menu" data-id="{{ menu.id }}" data-copy-url="{{ path(dashboard_routes.menu_copy|default('nowo_dashboard_menu_dashboard_menu_copy'), { id: menu.id }) }}" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-menu-copy')|raw }} title="{{ 'dashboard.copy'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.copy'|trans({}, 'NowoDashboardMenuBundle') }}">
                            {{ icons.copy()|raw }}
                        </button>
                        <button type="button" class="{{ ui.action('edit') }} btn-edit-menu" data-id="{{ menu.id }}" data-section="basic" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-menu-form')|raw }} title="{{ 'dashboard.edit_identity'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.edit_identity'|trans({}, 'NowoDashboardMenuBundle') }}">
                            {{ icons.edit()|raw }}
                        </button>
                        {% if not menu.base %}
                            <button type="button" class="{{ ui.action('edit') }} btn-edit-menu btn-edit-menu-config" data-id="{{ menu.id }}" data-section="config" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-menu-form')|raw }} title="{{ 'dashboard.edit_config'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.edit_config'|trans({}, 'NowoDashboardMenuBundle') }}">
                                {{ icons.config()|raw }}
                            </button>
                        {% endif %}
                        {% if not menu.base %}
                            <button type="button" class="{{ ui.action('delete') }} btn-delete-menu" data-id="{{ menu.id }}" data-name="{{ menu.code }}{% if menu.name %} — {{ menu.name }}{% endif %}" data-url="{{ path(dashboard_routes.menu_delete|default('nowo_dashboard_menu_dashboard_menu_delete'), { id: menu.id }) }}" data-token="{{ csrf_token('delete_menu_' ~ menu.id) }}" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-delete-confirm')|raw }} title="{{ 'dashboard.delete'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.delete'|trans({}, 'NowoDashboardMenuBundle') }}">
                                {{ icons.trash()|raw }}
                            </button>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
        {% if pagination is not null and pagination.total_pages > 1 %}
            <nav aria-label="{{ 'dashboard.pagination_menus'|trans({}, 'NowoDashboardMenuBundle') }}" class="mt-3">
                <ul class="pagination pagination-sm flex-wrap">
                    {% set indexRoute = dashboard_routes.index|default('nowo_dashboard_menu_dashboard_index') %}
                    {% set queryParams = search is not empty ? { q: search } : {} %}
                    <li class="page-item{% if pagination.current_page <= 1 %} disabled{% endif %}">
                        <a class="page-link" href="{% if pagination.current_page > 1 %}{{ path(indexRoute, queryParams|merge({ page: pagination.current_page - 1 })) }}{% else %}#{% endif %}" aria-label="{{ 'dashboard.previous'|trans({}, 'NowoDashboardMenuBundle') }}">«</a>
                    </li>
                    {% for p in 1..pagination.total_pages %}
                        <li class="page-item{% if p == pagination.current_page %} active{% endif %}">
                            <a class="page-link" href="{{ path(indexRoute, queryParams|merge({ page: p })) }}">{{ p }}</a>
                        </li>
                    {% endfor %}
                    <li class="page-item{% if pagination.current_page >= pagination.total_pages %} disabled{% endif %}">
                        <a class="page-link" href="{% if pagination.current_page < pagination.total_pages %}{{ path(indexRoute, queryParams|merge({ page: pagination.current_page + 1 })) }}{% else %}#{% endif %}" aria-label="{{ 'dashboard.next'|trans({}, 'NowoDashboardMenuBundle') }}">»</a>
                    </li>
                </ul>
                <p class="small {{ ui.muted() }} mt-1">
                    {% set from = menus|length > 0 ? (pagination.current_page - 1) * pagination.per_page + 1 : 0 %}
                    {% set to = (pagination.current_page - 1) * pagination.per_page + menus|length %}
                    {{ 'dashboard.showing_from_to_of_total'|trans({ '%from%': from, '%to%': to, '%total%': pagination.total }) }}
                </p>
            </nav>
        {% endif %}
    {% endif %}

    {# Modal: New menu (inline form) #}
    <div class="modal fade nowo-ui-modal" id="modal-menu-new" tabindex="-1" aria-labelledby="modal-menu-new-label" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable {{ modal_classes.menu_form|default('') }}">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-menu-new-label">{{ 'dashboard.new_menu'|trans({}, 'NowoDashboardMenuBundle') }}</h5>
                    <button type="button" class="btn-close" {{ ui.modal_dismiss_attrs()|raw }} aria-label="{{ 'dashboard.close'|trans({}, 'NowoDashboardMenuBundle') }}"></button>
                </div>
                <div class="modal-body">
                    {{ include('@NowoDashboardMenuBundle/dashboard/_menu_form_partial.html.twig', { form: new_menu_form, is_edit: false }) }}
                </div>
            </div>
        </div>
    </div>

    <script>
    window.__nowoDashboardMenuConfig = Object.assign(window.__nowoDashboardMenuConfig || {}, {
        dashboardBase: {{ path(dashboard_routes.index|default('nowo_dashboard_menu_dashboard_index')) |json_encode|raw }}
    });
    </script>
{% endblock %}
