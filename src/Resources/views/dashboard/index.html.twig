{#
  Menus list (REQ-UI-003): UiKit list scaffold. View model: page (ListPage from DashboardPages::indexPage()), rows
  {menu: Menu, items: int}; dialogs (form dialogs). Data blocks: nowo_ui_list_row (cells). Header, search filter,
  row actions (copy / edit / configuration open dialogs, delete = UiKit confirm), pagination and empty state come
  from the scaffold. Override per page: nowo_dashboard_menu.web_ui.templates.index.
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_list_row %}
    {% set _menu = row.menu %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ page.columns[0].label|nowo_ui_trans }}">
        {{ include('@NowoDashboardMenuBundle/dashboard/_dashboard_item_icon.html.twig', {item: _menu}, false) }}
        <a href="{{ path('nowo_dashboard_menu_dashboard_show', {id: _menu.id}) }}"><code class="{{ nowo_ui_class('code', page.bundle) }}">{{ _menu.code }}</code></a>
        {% if _menu.base %}<span class="{{ nowo_ui_class('badge_neutral', page.bundle) }} nowo-dashboard-menu-badge--base" title="{{ 'dashboard.base_badge_title'|trans({}, 'NowoDashboardMenuBundle') }}">{{ 'dashboard.base'|trans({}, 'NowoDashboardMenuBundle') }}</span>{% endif %}
    </td>
    <td class="{{ _cell }}{{ _menu.name ? '' : ' ' ~ nowo_ui_class('table_cell_muted', page.bundle) }}" data-label="{{ page.columns[1].label|nowo_ui_trans }}">{{ _menu.name ?: '—' }}</td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ page.columns[2].label|nowo_ui_trans }}" data-nowo-ui-priority="2"><span class="{{ nowo_ui_class('badge_neutral', page.bundle) }}">{{ row.items }}</span></td>
    {% set _dm_ctx = (_menu.context is iterable and _menu.context is not empty) ? (_menu.context|keys|join(', ')) : '' %}
    <td class="{{ _cell }}{{ _dm_ctx ? '' : ' ' ~ nowo_ui_class('table_cell_muted', page.bundle) }}" data-label="{{ page.columns[3].label|nowo_ui_trans }}" data-nowo-ui-priority="3">{{ _dm_ctx ?: '—' }}</td>
{% endblock %}

{% block nowo_ui_styles %}{{ parent() }}{{ include('@NowoDashboardMenuBundle/dashboard/_page_styles.html.twig') }}{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {{ include('@NowoDashboardMenuBundle/dashboard/_dialogs.html.twig', {dialogs: dialogs|default([]), bundle: page.bundle}) }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoDashboardMenuBundle/dashboard/_page_scripts.html.twig', {
        page_config: {dashboardBase: path('nowo_dashboard_menu_dashboard_index')},
    }) }}
{% endblock %}
