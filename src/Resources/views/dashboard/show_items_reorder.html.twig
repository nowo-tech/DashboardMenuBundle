{#
  Drag reorder of the items tree (REQ-UI-003 unique page: a sortable tree, no scaffold fits). Extends the layout
  (layout ?? nowo_ui_layout.admin), fills nowo_ui_document_title, nowo_ui_page_header (UiKit page_header partial),
  nowo_ui_content, nowo_ui_modals and nowo_ui_scripts. Context: header (PageHeader from
  DashboardPages::reorderHeader()), layout, bundle, menu, items_tree, reorder_form, dialogs.
  Blocks: nowo_dashboard_menu_sortable (the card), nowo_dashboard_menu_sortable_header (its heading).
  Keep #nowo-menu-sortable-root, .nowo-menu-sortable-list, #nowo-menu-sortable-form and #nowo-menu-sortable-payload
  (dashboard.js).
#}
{% extends layout ?? nowo_ui_layout.admin %}
{% set nowo_ui_bundle = bundle|default('NowoDashboardMenuBundle') %}
{% import '@NowoDashboardMenuBundle/dashboard/_sortable_tree_macro.html.twig' as sortable %}

{% block nowo_ui_document_title %}{{ header.title|nowo_ui_trans }} — {{ header.intro|nowo_ui_trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _actions %}{% for action in header.actions %}{{ include(nowo_ui_partial('action', nowo_ui_bundle), {action: action, context: 'toolbar', bundle: nowo_ui_bundle}, false) }}{% endfor %}{% endset %}
    {{ include(nowo_ui_partial('page_header', nowo_ui_bundle), {
        header: header,
        actions: header.actions,
        title: header.title|nowo_ui_trans,
        intro: header.intro is null ? null : header.intro|nowo_ui_trans,
        toolbar: _actions|trim,
        header_actions_rendered: true,
        region: 'header',
        bundle: nowo_ui_bundle,
    }, false) }}
{% endblock %}

{% block nowo_ui_content %}
    {% set _b = nowo_ui_bundle %}
    {% set current_locale = app is defined and app and app.request ? app.request.locale : 'en' %}
    <div class="nowo-dashboard-menu-reorder" data-testid="dashboard-menu-reorder">
        {% if items_tree is empty %}
            <p class="{{ nowo_ui_class('empty', _b) }}" data-nowo-ui-region="empty"{{ nowo_ui_attrs('empty', _b) }}>{{ 'dashboard.no_items'|trans({}, 'NowoDashboardMenuBundle') }}</p>
        {% else %}
            {% block nowo_dashboard_menu_sortable %}
                <section class="{{ nowo_ui_class('card', _b) }}" data-nowo-ui-region="section"{{ nowo_ui_attrs('card', _b) }}>
                    <header class="{{ nowo_ui_class('card_header', _b) }}">
                        {% block nowo_dashboard_menu_sortable_header %}
                            <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'dashboard.sortable_title'|trans({}, 'NowoDashboardMenuBundle') }}</h2>
                            <p class="{{ nowo_ui_class('card_intro', _b) }}">{{ 'dashboard.sortable_help'|trans({}, 'NowoDashboardMenuBundle') }}</p>
                        {% endblock %}
                    </header>
                    <div class="{{ nowo_ui_class('card_body', _b) }}">
                        <div id="nowo-menu-sortable-root">
                            <ul class="nowo-menu-sortable-list" data-parent-id="">
                                {{ sortable.sortable_items(items_tree, current_locale, _b) }}
                            </ul>
                        </div>
                        {{ form_start(reorder_form, {attr: {id: 'nowo-menu-sortable-form', class: nowo_ui_class('form', _b)}}) }}
                            {{ form_widget(reorder_form.tree, {attr: {id: 'nowo-menu-sortable-payload'}}) }}
                            <div class="{{ nowo_ui_class('form_actions', _b) }}">
                                <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'dashboard.sortable_apply'|trans({}, 'NowoDashboardMenuBundle') }}</button>
                            </div>
                        {{ form_end(reorder_form) }}
                    </div>
                </section>
            {% endblock %}
        {% endif %}
    </div>
{% endblock %}

{% block nowo_ui_styles %}{{ parent() }}{{ include('@NowoDashboardMenuBundle/dashboard/_page_styles.html.twig') }}{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {{ include('@NowoDashboardMenuBundle/dashboard/_dialogs.html.twig', {dialogs: dialogs|default([]), bundle: nowo_ui_bundle}) }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoDashboardMenuBundle/dashboard/_page_scripts.html.twig', {
        page_config: {baseUrl: path('nowo_dashboard_menu_dashboard_show', {id: menu.id}), menuId: menu.id, debug: app is defined and app ? app.debug : false},
    }) }}
{% endblock %}
