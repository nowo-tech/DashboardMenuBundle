{% import '@NowoDashboardMenuBundle/dashboard/_ui_macros.html.twig' as ui %}
<div id="modal-import-container">
    {% for msg in app.flashes('error') %}
        <div class="{{ ui.flash('error') }}">{{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('success') %}
        <div class="{{ ui.flash('success') }}">{{ msg }}</div>
    {% endfor %}
    <p class="{{ ui.muted() }} small">{{ 'dashboard.import_help'|trans({}, 'NowoDashboardMenuBundle') }}</p>
    {{ form_start(form, { attr: { enctype: 'multipart/form-data', class: 'import-form', 'data-import-form': '1' } }) }}
        <input type="hidden" name="_modal" value="1">
        {{ form_row(form.file, { row_attr: { class: 'mb-2' }, label_attr: { class: 'form-label' } }) }}
        {{ form_row(form.strategy, { row_attr: { class: 'mb-2' }, label_attr: { class: 'form-label' } }) }}
        {{ form_rest(form) }}
        <div class="{{ ui.row_actions() }}">
            <button type="submit" class="{{ ui.btn('primary') }}">{{ 'dashboard.import'|trans({}, 'NowoDashboardMenuBundle') }}</button>
            <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans({}, 'NowoDashboardMenuBundle') }}</button>
        </div>
    {{ form_end(form) }}
</div>
