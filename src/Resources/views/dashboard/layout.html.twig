{% trans_default_domain 'NowoDashboardMenuBundle' %}
{% set _dm_fw = nowo_dashboard_menu_css_framework|default('bootstrap5') %}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block nowo_ui_document_title %}{% block dashboard_title %}{{ 'dashboard.title'|trans }}{% endblock %} — {{ 'dashboard.title_suffix'|trans }}{% endblock %}</title>
    {% block stylesheets %}
        {% block nowo_ui_styles %}
            {# Demo layout CDNs — skipped when host sets layout_template to the project layout. #}
            {% if _dm_fw in ['bootstrap', 'bootstrap5', 'tabler'] %}
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
            {% elseif _dm_fw == 'bootstrap4' %}
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
            {% elseif _dm_fw == 'tailwind' %}
                <script src="https://cdn.tailwindcss.com"></script>
            {% elseif _dm_fw == 'foundation' %}
                <link href="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/css/foundation.min.css" rel="stylesheet">
            {% endif %}
            <link href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}" rel="stylesheet">
        {% endblock %}
        {% block dashboard_head %}
        <style>
            {# Tom Select dropdown appended to body must stack above Bootstrap 5 modals (z-index 1055). #}
            body > .ts-dropdown { z-index: 1060; }
            {# UiKit .nowo-ui-modal { display:none } must not override Bootstrap .modal.show #}
            .modal.nowo-ui-modal.show { display: block; }
            {# UiKit .nowo-ui-input defaults to max-width:20rem (toolbar); modal forms need full width. #}
            .dm-dashboard-form .nowo-ui-input,
            .dm-dashboard-form .form-control,
            .dm-dashboard-form .form-select {
                max-width: none;
                width: 100%;
            }
        </style>
        {% endblock %}
    {% endblock %}
    {% if stimulus_script_url is defined and stimulus_script_url %}
    <script type="module" src="{{ (stimulus_script_url starts with 'http') ? stimulus_script_url : asset(stimulus_script_url) }}"></script>
    {% endif %}
    {% if icon_selector_script_url is defined and icon_selector_script_url %}
    <script src="{{ (icon_selector_script_url starts with 'http') ? icon_selector_script_url : asset(icon_selector_script_url) }}" defer></script>
    {% endif %}
</head>
<body class="nowo-ui-body{% if _dm_fw in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} bg-light{% elseif _dm_fw == 'tailwind' %} bg-slate-50{% endif %}">
    {% if _dm_fw in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path(dashboard_routes.index|default('nowo_dashboard_menu_dashboard_index')) }}">{{ 'dashboard.title'|trans }}</a>
        </div>
    </nav>
    {% else %}
    <header class="nowo-ui-page-header" style="padding:0.75rem 1rem;border-bottom:1px solid #e2e8f0;background:#0f172a;">
        <a class="nowo-ui-btn nowo-ui-btn--link" style="color:#fff;" href="{{ path(dashboard_routes.index|default('nowo_dashboard_menu_dashboard_index')) }}">{{ 'dashboard.title'|trans }}</a>
    </header>
    {% endif %}
    <main class="{% if _dm_fw in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %}container-fluid py-4{% elseif _dm_fw == 'tailwind' %}mx-auto max-w-7xl px-4 py-6{% else %}nowo-ui-content{% endif %}" style="{% if _dm_fw in ['custom', 'none', 'foundation'] %}padding:1rem;{% endif %}">
        {% block nowo_ui_content %}{% block nowo_dashboard_menu_content %}{% endblock %}{% endblock %}
    </main>
    {% block javascripts %}
        {% block nowo_ui_scripts %}
            {% if _dm_fw in ['bootstrap', 'bootstrap5', 'tabler'] %}
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            {% elseif _dm_fw == 'bootstrap4' %}
                <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
            {% elseif _dm_fw == 'foundation' %}
                <script src="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/js/foundation.min.js"></script>
            {% endif %}
        {% endblock %}
        {% block dashboard_scripts %}{% endblock %}
        {# dashboard.js is loaded from base.html.twig so host layouts that only parent() still get it. #}
        <script>
        {% if icon_selector_script_url is defined and icon_selector_script_url %}
        window.dashboardMenuIconSelectorScriptUrl = {{ (icon_selector_script_url starts with 'http') ? icon_selector_script_url : asset(icon_selector_script_url) |json_encode|raw }};
        {% endif %}
        window.__nowoDashboardMenuConfig = Object.assign(window.__nowoDashboardMenuConfig || {}, {
            cssFramework: {{ _dm_fw|json_encode|raw }}
        });
        window.dashboardMenuI18n = {
            loading: {{ 'dashboard.loading'|trans|json_encode|raw }},
            errorLoadingForm: {{ 'dashboard.error_loading_form'|trans|json_encode|raw }},
            deleteMenuConfirm: {{ 'dashboard.delete_menu_confirm'|trans|json_encode|raw }},
            editItem: {{ 'dashboard.edit_item'|trans|json_encode|raw }},
            editLabels: {{ 'dashboard.edit_labels'|trans|json_encode|raw }},
            editTypePositionIcon: {{ 'dashboard.edit_type_position_icon'|trans|json_encode|raw }},
            editConfig: {{ 'dashboard.edit_config'|trans|json_encode|raw }},
            editMenu: {{ 'dashboard.edit_menu'|trans|json_encode|raw }},
            addItem: {{ 'dashboard.add_item'|trans|json_encode|raw }},
            deleteItemConfirm: {{ 'dashboard.delete_item_confirm'|trans|json_encode|raw }}
        };
        </script>
    {% endblock %}
</body>
</html>
