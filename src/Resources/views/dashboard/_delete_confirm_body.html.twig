{#
  Delete confirmation body (menu / item). Variables from _menu_dashboard_modals.html.twig:
  _dm_message_id, _dm_message, _dm_form (FormView|null), _dm_form_id.
  Classes: dashboard.ui.classes.modal_message / modal_actions / button_secondary / button_danger.
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _dm_message_class = dashboard_menu_ui_class('modal_message', '') %}
<p{% if _dm_message_class %} class="{{ _dm_message_class }}"{% endif %} id="{{ _dm_message_id }}">{{ _dm_message }}</p>
{% if _dm_form %}
    {{ form_start(_dm_form, { attr: { id: _dm_form_id } }) }}
        {% if nowo_dashboard_menu_ui.classes.modal_actions is defined %}
        <div class="{{ nowo_dashboard_menu_ui.classes.modal_actions }}">
        {% else %}
        <div class="{{ ui.row_actions() }}" style="justify-content:flex-end;">
        {% endif %}
            <button type="button" class="{{ dashboard_menu_ui_class('button_secondary', ui.btn('secondary')) }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans({}, 'NowoDashboardMenuBundle') }}</button>
            <button type="submit" class="{{ dashboard_menu_ui_class('button_danger', ui.btn('danger')) }}">{{ 'dashboard.delete'|trans({}, 'NowoDashboardMenuBundle') }}</button>
        </div>
    {{ form_end(_dm_form) }}
{% endif %}
