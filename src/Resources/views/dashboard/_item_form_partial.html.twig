{#
  Item form dialog fragment (GET ?_modal=1). Same fields as the page (_item_form_fields.html.twig) inside
  #modal-item-form-container (dashboard.js wires the type toggles, Stimulus and the icon selector there).
  Override: web_ui.templates.item_form_partial. Variables: form, menu, is_edit, app_routes, locales,
  item_has_children, section_focus, show_translations.
#}
{% if nowo_dashboard_ux_autocomplete_available|default(false) %}
    {% form_theme form '@SymfonyUXAutocomplete/autocomplete_form_theme.html.twig' %}
{% endif %}
{% set _b = 'NowoDashboardMenuBundle' %}
<div id="modal-item-form-container" data-app-routes="{{ app_routes|default({})|json_encode|e('html_attr') }}" data-item-has-children="{{ item_has_children|default(false) ? 'true' : 'false' }}" data-section-focus="{{ section_focus|default('') }}">
    {{ form_start(form, {attr: {class: nowo_ui_class('form', _b) ~ ' nowo-dashboard-menu-form'}}) }}
        {{ include('@NowoDashboardMenuBundle/dashboard/_item_form_fields.html.twig', {bundle: _b}) }}
        {{ form_rest(form) }}
        {{ include('@NowoDashboardMenuBundle/dashboard/_dialog_form_actions.html.twig', {submit_label: (is_edit|default(false) ? 'dashboard.update' : 'dashboard.create')|trans({}, 'NowoDashboardMenuBundle'), bundle: _b}) }}
    {{ form_end(form) }}
</div>
