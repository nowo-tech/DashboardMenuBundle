{#
  New / edit menu item (REQ-UI-003): UiKit form scaffold. View model: page (FormPage from
  DashboardPages::itemFormPage()). Extra context: form, menu, is_edit, app_routes, locales, item_has_children,
  section_focus, show_translations; live (true when the configuration section renders the Live component: the
  component prints its fields inside the scaffold form in embedded mode and the scaffold form posts natively).
  Data block: nowo_ui_form_body. Dialog fragments: _item_form_partial.html.twig, _item_form_live_partial.html.twig.
  Override per page: nowo_dashboard_menu.web_ui.templates.item_form.
#}
{% extends '@NowoUiKit/page/form.html.twig' %}

{% block nowo_ui_styles %}{{ parent() }}{{ include('@NowoDashboardMenuBundle/dashboard/_page_styles.html.twig') }}{% endblock %}

{% block nowo_ui_form_body %}
    {% if nowo_dashboard_ux_autocomplete_available|default(false) and not (live|default(false)) %}
        {% form_theme form '@SymfonyUXAutocomplete/autocomplete_form_theme.html.twig' %}
    {% endif %}
    <div id="modal-item-form-container" class="nowo-dashboard-menu-form" data-app-routes="{{ app_routes|default({})|json_encode|e('html_attr') }}" data-item-has-children="{{ item_has_children|default(false) ? 'true' : 'false' }}" data-section-focus="{{ section_focus|default('') }}">
        {% if live|default(false) %}
            {{ component('dashboard_menu_item_form', {
                menu: menu,
                appRoutes: app_routes,
                excludeIds: exclude_ids|default([]),
                locale: locale|default('en'),
                isEdit: true,
                itemHasChildren: item_has_children|default(false),
                actionUrl: action_url,
                redirectToUrl: redirect_to_url,
                initialFormData: item,
                itemId: item.id,
                locales: locales|default([]),
                sectionFocus: section_focus|default(null),
                embedded: true,
            }) }}
        {% else %}
            {{ include('@NowoDashboardMenuBundle/dashboard/_item_form_fields.html.twig', {bundle: page.bundle}) }}
        {% endif %}
    </div>
    {{ parent() }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoDashboardMenuBundle/dashboard/_page_scripts.html.twig', {
        page_config: {itemFormPage: true},
    }) }}
{% endblock %}
