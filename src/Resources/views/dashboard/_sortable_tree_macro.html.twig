{#- Nested sortable list of the reorder page (semantic classes only; dashboard.js + SortableJS drive it). -#}
{% macro sortable_items(nodes, currentLocale, bundle = null) %}
    {% for node in nodes %}
        <li class="nowo-menu-sortable-item" data-item-id="{{ node.item.id }}" data-item-type="{{ node.item.itemType }}">
            <span class="nowo-menu-sortable-handle {{ nowo_ui_class('muted', bundle) }}" role="button" tabindex="0" title="{{ 'dashboard.sortable_drag_handle'|trans({}, 'NowoDashboardMenuBundle') }}" aria-label="{{ 'dashboard.sortable_drag_handle'|trans({}, 'NowoDashboardMenuBundle') }}">⋮⋮</span>
            {{ include('@NowoDashboardMenuBundle/dashboard/_dashboard_item_icon.html.twig', {item: node.item}, false) }}
            <span class="{{ nowo_ui_class('badge_neutral', bundle) }} nowo-dashboard-menu-badge--type">{{ node.item.itemType }}</span>
            {{ node.item.getLabelForLocale(currentLocale) ?: ('dashboard.no_label'|trans({}, 'NowoDashboardMenuBundle')) }}
            <ul class="nowo-menu-sortable-list nowo-menu-sortable-nested" data-parent-id="{{ node.item.id }}">
                {% if node.children is not empty %}
                    {{ _self.sortable_items(node.children, currentLocale, bundle) }}
                {% endif %}
            </ul>
        </li>
    {% endfor %}
{% endmacro %}
