{% extends nowo_dashboard_layout_template|default('@NowoDashboardMenuBundle/dashboard/layout.html.twig') %}
{% trans_default_domain 'NowoDashboardMenuBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

{% set dashboard_routes = dashboard_routes|default({
    index: 'nowo_dashboard_menu_dashboard_index',
    show: 'nowo_dashboard_menu_dashboard_show',
    export_all: 'nowo_dashboard_menu_dashboard_export_all',
    export_menu: 'nowo_dashboard_menu_dashboard_export_menu',
    import: 'nowo_dashboard_menu_dashboard_import',
    menu_copy: 'nowo_dashboard_menu_dashboard_menu_copy',
}) %}

{# When the host sets layout_template to the project layout, stack assets via parent().
   Do NOT redefine nested nowo_ui_styles / nowo_ui_scripts here — that would replace the
   layout CDN (Bootstrap/etc.) when parent() is rendered (Twig nested-block inheritance). #}
{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/dashboard.js', 'nowo_dashboard_menu') }}" defer></script>
{% endblock %}

{% block nowo_dashboard_menu_content %}
    {% set modal_classes = modal_classes|default({}) %}
    {% block nowo_ui_flashes %}
        {% for msg in app.flashes('success') %}
            <div class="{{ ui.flash('success') }}">{{ msg }}</div>
        {% endfor %}
        {% for msg in app.flashes('danger') %}
            <div class="{{ ui.flash('danger') }}">{{ msg }}</div>
        {% endfor %}
        {% for msg in app.flashes('error') %}
            <div class="{{ ui.flash('error') }}">{{ msg }}</div>
        {% endfor %}
        {% for msg in app.flashes('info') %}
            <div class="{{ ui.flash('info') }}">{{ msg }}</div>
        {% endfor %}
    {% endblock %}

    {# Do not redefine nowo_ui_content here — layout nests nowo_dashboard_menu_content
       inside nowo_ui_content; a child redefinition would replace that and drop modals. #}
    {% block body %}{% endblock %}

    {% block nowo_ui_modals %}
        {% include '@NowoDashboardMenuBundle/dashboard/_menu_dashboard_modals.html.twig' %}
    {% endblock %}
{% endblock %}
