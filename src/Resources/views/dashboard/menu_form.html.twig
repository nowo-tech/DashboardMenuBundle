{#
  New / edit menu (REQ-UI-003): UiKit form scaffold. View model: page (FormPage from DashboardPages::menuFormPage()).
  Extra context: form, is_edit, section_focus (basic | config | null), menu. Data block: nowo_ui_form_body (the
  definition / configuration fieldsets of _menu_form_fields.html.twig). The same fields open in a dialog through
  _menu_form_partial.html.twig (?_modal=1). Override per page: nowo_dashboard_menu.web_ui.templates.menu_form.
#}
{% extends '@NowoUiKit/page/form.html.twig' %}

{% block nowo_ui_styles %}{{ parent() }}{{ include('@NowoDashboardMenuBundle/dashboard/_page_styles.html.twig') }}{% endblock %}

{% block nowo_ui_form_body %}
    <div class="nowo-dashboard-menu-form">
        {{ include('@NowoDashboardMenuBundle/dashboard/_menu_form_fields.html.twig', {form: form, section_focus: section_focus|default(null), is_edit: is_edit|default(false), bundle: page.bundle}) }}
    </div>
    {{ parent() }}
{% endblock %}
