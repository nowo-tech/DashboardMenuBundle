{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{#- Chrome: dashboard.ui.classes.{modal_form, modal_content, modal_section, modal_actions, button_primary, button_secondary}, dashboard.ui.form_themes. -#}
{% set _dm_ui = nowo_dashboard_menu_ui|default({}) %}
{% if _dm_ui.form_themes|default([]) is not empty %}{% form_theme form with _dm_ui.form_themes %}{% endif %}
{% set _dm_section = _dm_ui.classes.modal_section ?? null %}
{% set _section_focus = section_focus|default('') %}
{# Definition modal: only form.definition. Configuration modal: only form.config. New menu / full edit: both if available. #}
{% set _show_definition = form.definition is defined and (_section_focus == '' or _section_focus == 'basic') %}
{% set _show_config = form.config is defined and (_section_focus == 'config' or (_section_focus == '' and is_edit|default(false))) %}
{{ form_start(form, { attr: { class: dashboard_menu_ui_class('modal_form', 'form form-vertical') ~ ' dm-dashboard-form' } }) }}
    {% if _section_focus != '' %}
        <input type="hidden" name="_section" value="{{ _section_focus }}">
    {% endif %}
    <div class="{{ dashboard_menu_ui_class('modal_content', 'row mb-2') }}">
        {% if _show_definition %}
        <div id="menu_definition_section">
        {% if _dm_section is not null %}
        <p class="{{ _dm_section }}">{{ 'form.menu_type.section_definition'|trans({}, 'NowoDashboardMenuBundle') }}</p>
        {% else %}
        <p class="{{ ui.muted() }} small mb-2">
            <span class="bi bi-pencil-fill me-1" aria-hidden="true"></span>
            {{ 'form.menu_type.section_definition'|trans({}, 'NowoDashboardMenuBundle') }}
        </p>
        {% endif %}
        {% for field in form.definition %}
            {{ form_row(field) }}
        {% endfor %}
        </div>
        {% endif %}

        {% if _show_config %}
        <div id="menu_config_section">
        {% if _show_definition %}<hr class="my-3">{% endif %}
        {% if _dm_section is not null %}
        <p class="{{ _dm_section }}">{{ 'form.menu_type.section_config'|trans({}, 'NowoDashboardMenuBundle') }}</p>
        {% else %}
        <p class="{{ ui.muted() }} small mb-2">
            <span class="bi bi-gear-fill me-1" aria-hidden="true"></span>
            {{ 'form.menu_type.section_config'|trans({}, 'NowoDashboardMenuBundle') }}
        </p>
        {% endif %}
        {% for field in form.config %}
            {% if field.vars.name == 'classMenu' %}
                <hr class="my-3">
                <p class="{{ _dm_section ?? (ui.muted() ~ ' small mb-2') }}">{{ 'form.menu_type.css_section_heading'|trans({}, 'NowoDashboardMenuBundle') }}</p>
            {% endif %}
            {{ form_row(field) }}
        {% endfor %}
        </div>
        {% endif %}
    </div>
    {% set _dm_submit_label = (is_edit|default(false) ? 'dashboard.update' : 'dashboard.create')|trans({}, 'NowoDashboardMenuBundle') %}
    {% if _dm_ui.classes.modal_actions is defined %}
    <div class="{{ _dm_ui.classes.modal_actions }}">
        <button type="button" class="{{ dashboard_menu_ui_class('button_secondary', ui.btn('secondary')) }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans({}, 'NowoDashboardMenuBundle') }}</button>
        <button type="submit" class="{{ dashboard_menu_ui_class('button_primary', ui.btn('primary')) }}">{{ _dm_submit_label }}</button>
    </div>
    {% else %}
    <button type="submit" class="{{ dashboard_menu_ui_class('button_primary', ui.btn('primary')) }}">{{ _dm_submit_label }}</button>
    {% endif %}
{{ form_end(form) }}
