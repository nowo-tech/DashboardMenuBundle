{#
  Menu form dialog fragment (GET ?_modal=1, loaded by dashboard.js into the UiKit dialog). Same fields as the page
  (_menu_form_fields.html.twig); submit + cancel (closes the dialog). Override: web_ui.templates.menu_form_partial.
  Variables: form, is_edit, section_focus.
#}
{% set _b = 'NowoDashboardMenuBundle' %}
{{ form_start(form, {attr: {class: nowo_ui_class('form', _b) ~ ' nowo-dashboard-menu-form'}}) }}
    {{ include('@NowoDashboardMenuBundle/dashboard/_menu_form_fields.html.twig', {form: form, section_focus: section_focus|default(null), is_edit: is_edit|default(false), bundle: _b}) }}
    {{ include('@NowoDashboardMenuBundle/dashboard/_dialog_form_actions.html.twig', {submit_label: (is_edit|default(false) ? 'dashboard.update' : 'dashboard.create')|trans({}, 'NowoDashboardMenuBundle'), bundle: _b}) }}
{{ form_end(form) }}
